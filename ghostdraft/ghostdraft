usage() { t usage; }

cmd_version() { echo "ghostdraft $VERSION"; }

# pipe — read stdin, print to the terminal, write NOTHING to disk.
# The safest mode: cat creates no temporary files. We honestly warn that the
# terminal scrollback still holds the text in memory (this is not "zero traces").
cmd_pipe() {
  cat
  [[ -t 2 ]] && warn "$(t pipe_scrollback)"
  return 0
}

# --- new: ephemeral draft (vault / RAM disk) + shred + editor-residue cleanup ---

# State for the cleanup trap (filled in as cmd_new runs).
_GD_DRAFT_FILE=""   # path to the draft file
_GD_RAM_DEV=""      # dev node of the RAM disk if we created it (for detach)

# Is the volume mounted and writable? The mount fact itself is asked of the
# canonical `_volume_mounted` from vendored common.sh — the single answer to
# that question in the ecosystem; only the ghostdraft-specific part remains here:
# a draft may only be written into a writable directory. We do not write to a
# path that merely looks like a vault.
_is_mounted_writable() {
  local vol="$1"
  [[ -n "$vol" && -d "$vol" && -w "$vol" ]] || return 1
  _volume_mounted "$vol"
}

# Unique RAM-disk volume name: ghostdraft-ram-<8 hex>. Uniqueness is needed so that
# parallel instances (or an undetached leftover) don't share one /Volumes/ghostdraft-ram
# (macOS would then mount the second one as "ghostdraft-ram 1" — our detach by the fixed
# name would miss). Entropy comes from /dev/urandom (same as in seedsplit), no dependency on $RANDOM.
_ram_volname() {
  local suffix
  suffix="$(head -c 4 /dev/urandom 2>/dev/null | od -An -v -tx1 | tr -d ' \n')"
  [[ -n "$suffix" ]] || suffix="$$"   # degradation: PID if urandom is unavailable
  printf 'ghostdraft-ram-%s' "$suffix"
}

# Create a RAM disk (HFS+). Prints "<mnt>\t<dev>"; exit code != 0 — failed.
# IMPORTANT: the dev node is returned via stdout, NOT via a global — the function is
# called in a command substitution ($(...)), where a global assignment would be lost
# in the subshell (this is how the RAM disk used to leak without a detach).
# GHOSTDRAFT_DISABLE_RAM=1 disables it (tests must not create real RAM disks).
_ram_make() {
  [[ "${GHOSTDRAFT_DISABLE_RAM:-0}" == "1" ]] && return 1
  command -v hdiutil >/dev/null 2>&1 || return 1
  local sectors dev mnt volname
  sectors=$(( 64 * 1024 * 1024 / 512 ))   # 64 MiB; 512 B sectors
  dev="$(hdiutil attach -nomount "ram://${sectors}" 2>/dev/null)" || return 1
  dev="$(printf '%s' "$dev" | tr -d '[:space:]')"
  [[ -n "$dev" ]] || return 1
  volname="$(_ram_volname)"
  if ! diskutil erasevolume HFS+ "$volname" "$dev" >/dev/null 2>&1; then
    hdiutil detach "$dev" >/dev/null 2>&1 || true
    return 1
  fi
  # Take the real mountpoint from diskutil (rather than guessing /Volumes/<volname>): macOS
  # could add a suffix on a collision — we detach by dev node, the path must be exact.
  mnt="$(diskutil info "$dev" 2>/dev/null | awk -F': +' '/Mount Point/{print $2; exit}')"
  [[ -n "$mnt" ]] || mnt="/Volumes/${volname}"
  if [[ ! -d "$mnt" || ! -w "$mnt" ]]; then
    hdiutil detach "$dev" >/dev/null 2>&1 || true
    return 1
  fi
  printf '%s\t%s' "$mnt" "$dev"
}

# Pick a directory for the draft. Prints "<dir>\t<kind>\t<ram_dev>" (ram_dev is empty
# if it's not a RAM disk); exit code != 0 — no safe location. Priority: GHOSTDRAFT_DIR
# (override) → open vault → RAM disk. ram_dev is carried via stdout so the parent
# can do the detach (see _ram_make — a global would not survive the $(...) subshell).
_pick_draft_dir() {
  local ov="${GHOSTDRAFT_DIR:-}"
  if [[ -n "$ov" ]]; then
    mkdir -p "$ov" 2>/dev/null || true
    if [[ -d "$ov" && -w "$ov" ]]; then printf '%s\toverride\t' "$ov"; return 0; fi
  fi
  local vol="${ST_VAULT_VOLUME:-/Volumes/SecretVault}"
  if _is_mounted_writable "$vol"; then printf '%s\tvault\t' "$vol"; return 0; fi
  local rdpair rmnt rdev
  if rdpair="$(_ram_make)"; then
    IFS=$'\t' read -r rmnt rdev <<<"$rdpair"
    printf '%s\tram\t%s' "$rmnt" "$rdev"; return 0
  fi
  return 1
}

# Overwrite and delete a file. We prefer securetrash shred (its honest logic);
# otherwise fallback: overwrite with random bytes + rm. On a RAM disk the real erasure
# is the detach (bytes are in RAM), on a vault — closing the container (crypto-shred);
# the fallback on an SSD is best-effort and no guarantee (exactly what securetrash warns about).
_shred_file() {
  local f="$1"
  [[ -n "$f" && -e "$f" ]] || return 0
  if command -v securetrash >/dev/null 2>&1; then
    ST_ASSUME_YES=1 securetrash shred "$f" >/dev/null 2>&1 && return 0
  fi
  local n; n="$(wc -c <"$f" 2>/dev/null || echo 0)"
  if [[ "$n" -gt 0 ]]; then
    dd if=/dev/urandom of="$f" bs="$n" count=1 conv=notrunc 2>/dev/null || true
  fi
  rm -f "$f" 2>/dev/null || true
}

# Remove editor residue next to the draft: vim swap/undo, nano backup.
# Honestly: ~/.viminfo, OS swap and scrollback we CANNOT selectively scrub (see new_residue).
_clean_editor_residue() {
  local f="$1" dir base
  [[ -n "$f" ]] || return 0
  dir="$(dirname "$f")"; base="$(basename "$f")"
  rm -f "$dir/.$base.swp" "$dir/.$base.swo" "$dir/.$base.swn" "$dir/.$base.un~" \
        "$dir/$base~" 2>/dev/null || true
}

# Clear the clipboard ONLY if it still holds our secret (don't wipe something the
# user copied later). We compare pbpaste against the known contents.
_clip_clear_if_match() {
  local want="$1"
  command -v pbpaste >/dev/null 2>&1 || return 0
  [[ "$(pbpaste 2>/dev/null)" == "$want" ]] && printf '' | pbcopy 2>/dev/null
  return 0
}

# Put the draft into the system clipboard with an explicit confirmation (dangerous:
# clipboard managers + iCloud Universal Clipboard). Auto-clear after N seconds in the
# background, but only if the clipboard has not changed. Exit code != 0 — clipboard
# untouched (the caller proceeds with the shred).
_clip_put() {
  local f="$1" secs content
  command -v pbcopy >/dev/null 2>&1 || { warn "$(t clip_no_pbcopy)"; return 1; }
  warn "$(t clip_danger)"
  if ! confirm "$(t clip_confirm)"; then warn "$(t clip_cancelled)"; return 1; fi
  pbcopy < "$f"
  secs="${GHOSTDRAFT_CLIP_SECS:-20}"
  content="$(cat "$f")"
  info "$(t clip_set "$secs")"
  # Background: wait and clear if the clipboard is still ours. We close stdout/stderr
  # so as not to hold the caller's pipe; functions are inherited into the ( ) subshell.
  ( sleep "$secs"; _clip_clear_if_match "$content" ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
  return 0
}

# Trap: shred the file → clean editor residue → detach the RAM disk (if ours).
_gd_cleanup() {
  _shred_file "$_GD_DRAFT_FILE"
  _clean_editor_residue "$_GD_DRAFT_FILE"
  if [[ -n "$_GD_RAM_DEV" ]]; then
    hdiutil detach "$_GD_RAM_DEV" >/dev/null 2>&1 || true
    _GD_RAM_DEV=""
  fi
}

cmd_new() {
  require_macos
  # The editor needs an interactive terminal. In a pipe / non-interactive runner / embedded
  # command box vim(nano) would open, but keystrokes would never reach it — the user gets stuck
  # in an uncontrollable editor. Fail-closed with a hint BEFORE creating the RAM disk/draft.
  # GD_ASSUME_TTY=1 — bypass for tests (the editor is mocked non-interactive there).
  if [[ "${GD_ASSUME_TTY:-0}" != "1" && ( ! -t 0 || ! -t 1 ) ]]; then
    err "$(t new_needs_tty)"; exit 1
  fi
  # Warp is a real TTY (the guard above passes), but its AI popup ("Use agent") steals
  # focus, and it binds the F-keys for itself → input never reaches the editor, a newbie gets stuck.
  # Not fatal: print a one-off hint (Esc closes the popup; leave the editor with Ctrl-D / Ctrl-X).
  if [[ "${TERM_PROGRAM:-}" == "WarpTerminal" ]]; then
    warn "$(t new_warp_hint)"
  fi
  local use_clip=0 a
  for a in "$@"; do
    case "$a" in
      --clipboard) use_clip=1 ;;
      *) t unknown_cmd "$a" >&2; echo >&2; exit 1 ;;
    esac
  done

  local pick dir kind ram_dev
  if ! pick="$(_pick_draft_dir)"; then err "$(t new_no_loc)"; exit 3; fi
  IFS=$'\t' read -r dir kind ram_dev <<<"$pick"
  _GD_RAM_DEV="$ram_dev"   # in the parent — so the trap can do the detach

  # Draft file: mktemp in the chosen directory, mode 600.
  local f
  f="$(mktemp "${dir%/}/.ghostdraft.XXXXXX")" || { err "$(t new_no_loc)"; _gd_cleanup; exit 3; }
  chmod 600 "$f"
  _GD_DRAFT_FILE="$f"
  trap _gd_cleanup EXIT INT TERM

  case "$kind" in
    vault)    info "$(t new_loc_vault "$dir")" ;;
    ram)      info "$(t new_loc_ram "$dir")" ;;
    override) warn "$(t new_loc_override "$dir")" ;;
  esac

  # Editor: respect $EDITOR (flags allowed, e.g. "vim -i NONE"); otherwise the default is
  # `vim -i NONE`: soft-wraps long lines (the key doesn't run off the edge and doesn't get
  # broken by inserted newlines) + `-i NONE` disables ~/.viminfo, which we otherwise
  # CANNOT scrub (see new_residue). No vim — nano.
  #
  # Parsing $EDITOR: first try it as a WHOLE path, and only then split into words. A path
  # with a space is normal on macOS (`/Applications/Visual Studio Code.app/…/code`), and
  # `read -ra` used to tear it apart, so the editor never launched at all. `eval` is
  # deliberately NOT used here: it would perform substitutions inside the environment
  # variable (`$(…)`), which is a different class of trust than "run the named program".
  local -a _ed=()
  if [[ -n "${EDITOR:-}" ]]; then
    if [[ -x "$EDITOR" ]] || command -v "$EDITOR" >/dev/null 2>&1; then
      _ed=("$EDITOR")
    else
      read -ra _ed <<<"$EDITOR"
    fi
  fi
  # Empty/whitespace $EDITOR (read -ra yields an empty array) → default; don't try
  # to execute the draft itself as a command.
  if [[ ${#_ed[@]} -eq 0 ]]; then
    if command -v vim >/dev/null 2>&1; then
      # A friendly default vim. Exit is ONE key that works from ANY mode:
      # Ctrl-D saves and exits, Ctrl-X exits without saving. Done this way because every
      # previous approach broke against a live user: the terminal (Warp) intercepts F-keys,
      # and `ZZ`/`ZQ` only work in normal mode — from insert mode they are simply typed
      # into the text, and the editor looks frozen. Terminals pass a Ctrl chord through,
      # and it doesn't depend on which mode the person landed in.
      # `q` in normal mode is disabled deliberately: a missed `ZQ` started macro recording
      # (`recording @q` in the status bar), after which the editor stops responding to the
      # familiar keys — exactly the dead end that trapped a newbie. Macros are not needed
      # in a notepad for an ephemeral note.
      # F2/F3 and ZZ/ZQ/:wq/:q! are left as is — those who know them lose nothing.
      # `-i NONE` — the same privacy (no ~/.viminfo). Applied ONLY to the default:
      # the user's own $EDITOR is not touched.
      # NB: a raw `|` is not allowed in the statusline (vim treats it as a command
      # separator) — hence space separators; spaces are escaped as `\ ` (a :set statusline requirement).
      # NB2: vim accepts a MAXIMUM of 10 `-c` arguments ("Too many \"+command\"") and on the
      # eleventh simply refuses to start — i.e. the notepad would not open at all.
      # Therefore all mappings live in ONE `-c`: `|` cannot be placed between the :map
      # commands themselves (it would leak into the right-hand side of the mapping), but
      # between `execute "…"` calls it can.
      # `-N` + `startinsert`: the notepad opens READY TO TYPE. vim starts in normal mode,
      # where letters are commands: the person types, no text appears, and the bottom shows
      # the stub of a half-entered command (`f` waits for the next character) — exactly what
      # "I can't write" looked like. Without a ~/.vimrc vim also drops into compatible mode,
      # where Backspace and arrows in insert behave unlike what any non-vim user expects;
      # `-N` removes that. `showmode` displays `-- INSERT --` so the mode is visible.
      _ed=(vim -N -i NONE
        -c 'set laststatus=2 backspace=indent,eol,start showmode'
        -c 'set statusline=\ \ Ctrl-D\ =\ save\ &\ exit\ \ \ \ Ctrl-X\ =\ discard\ \ \ \ works\ in\ any\ mode\ \ \ \ (Esc\ then\ ZZ\ /\ ZQ\ also\ work)'
        -c 'execute "nnoremap <silent> <C-d> :wq<CR>" | execute "inoremap <silent> <C-d> <Esc>:wq<CR>" | execute "vnoremap <silent> <C-d> <Esc>:wq<CR>" | execute "nnoremap <silent> <C-x> :q!<CR>" | execute "inoremap <silent> <C-x> <Esc>:q!<CR>" | execute "vnoremap <silent> <C-x> <Esc>:q!<CR>" | execute "nnoremap q <Nop>" | execute "nnoremap <F2> :wq<CR>" | execute "inoremap <F2> <Esc>:wq<CR>" | execute "nnoremap <F3> :q!<CR>" | execute "inoremap <F3> <Esc>:q!<CR>"'
        -c 'startinsert')
    else
      _ed=(nano)
    fi
  fi
  "${_ed[@]}" "$f"

  [[ $use_clip == 1 ]] && { _clip_put "$f" || true; }   # the clipboard must not break the shred

  warn "$(t new_residue)"
  # cleanup fires via trap EXIT (shred + residue cleanup + RAM detach).
}

main() {
  # --yes anywhere in the arguments == ST_ASSUME_YES=1 (same contract as securetrash:
  # previously the clipboard-clear confirmation could only be bypassed via env). The flag
  # is stripped, the order of the remaining arguments is preserved.
  # After `--` arguments are literal — same contract as vaultwatch.
  local args=() a literal=0
  for a in "$@"; do
    if [[ "$literal" == 0 && "$a" == "--yes" ]]; then ST_ASSUME_YES=1; continue; fi
    [[ "$a" == "--" ]] && literal=1
    args+=("$a")
  done
  set -- "${args[@]:-}"
  # An empty array expands into a single empty string — normalize to "no arguments".
  if [[ $# -eq 1 && -z "${1:-}" ]]; then set --; fi

  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then usage; exit 1; fi
  shift || true
  case "$cmd" in
    version|-v|--version) cmd_version "$@" ;;
    help|--help|-h) usage ;;
    pipe)           cmd_pipe "$@" ;;
    new)            cmd_new "$@" ;;
    *) t unknown_cmd "$cmd" >&2; echo >&2; usage >&2; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
