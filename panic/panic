usage() { t usage; }

# Mount points of mounted disk images under /Volumes (vaults, dmg).
# We parse `hdiutil info`: dev lines are TAB-separated → the mountpoint (3rd field) is correct
# even with spaces. The /Volumes/ filter excludes system images (mounted outside /Volumes).
_mounted_images() {
  hdiutil info 2>/dev/null | awk -F'\t' '/^\/dev\/disk/ && $3 ~ /^\/Volumes\// {print $3}'
}

# Screen lock via the configurable locker.
# Lock the screen. Returns 0 ONLY if the lock was actually initiated — otherwise
# cmd_now honestly reports the screen is NOT locked (instead of lying "locked screen", as it
# used to when CGSession failed silently on modern macOS). Methods in decreasing reliability.
_lock_screen() {
  if [[ -x "$PANIC_CGSESSION" ]] && "$PANIC_CGSESSION" -suspend >/dev/null 2>&1; then
    return 0
  fi
  # Ctrl+Cmd+Q is the system lock on modern macOS. Without Accessibility access osascript
  # returns an error → honestly NOT counted as success.
  if [[ -x "$PANIC_OSASCRIPT" ]] && \
     "$PANIC_OSASCRIPT" -e 'tell application "System Events" to keystroke "q" using {control down, command down}' >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

# --hard: kill known cloud daemons (best-effort, a missing process is not an error).
_kill_cloud_daemons() {
  local d
  for d in "${PANIC_CLOUD_DAEMONS[@]}"; do
    pkill -x "$d" >/dev/null 2>&1 || true
  done
}

# --hard: clear Recent items (shared file lists). HONESTLY: covers the global
# lists in PANIC_SFL_DIR; per-app "recents" inside applications are not erased by this.
_clear_recent_items() {
  rm -f "$PANIC_SFL_DIR"/*.sfl* 2>/dev/null || true
}

# Kill-switch: hide and lock. NO confirm — this is panic mode (speed matters more);
# the guard against accidental runs is the explicit `now` verb. detach -force with open
# files may corrupt data: a deliberate trade-off (see README "Scope & limitations").
cmd_now() {
  require_macos
  local hard=0 a
  for a in "$@"; do
    case "$a" in --hard) hard=1 ;; esac
  done

  # 1. Detach all mounted disk images (force — panic outranks open files).
  local n=0 mp
  while IFS= read -r mp; do
    [[ -n "$mp" ]] || continue
    if hdiutil detach -force "$mp" >/dev/null 2>&1; then
      n=$((n + 1))
    else
      warn "$(t detach_fail "$mp")"
    fi
  done < <(_mounted_images)

  # 2. Clear the clipboard. 3. Lock the screen (status kept for an honest report).
  pbcopy </dev/null >/dev/null 2>&1 || true
  local locked=0
  if _lock_screen; then locked=1; fi

  # 4. --hard: kill cloud daemons + clear Recent items.
  if [[ "$hard" == "1" ]]; then
    _kill_cloud_daemons
    _clear_recent_items
  fi

  # The post-report is best-effort: under `set -euo pipefail`, multi-line output into a closed
  # pipe (`panic now | head -n1`) yields SIGPIPE→141 even though the panic already ran. The report
  # must not sink the exit code of a successful panic: `trap '' PIPE` mutes the signal (echo returns
  # EPIPE instead of dying), and `|| true` guards against set -e on that return. This is cmd_now's last action.
  trap '' PIPE
  info "$(t now_report "$n")" || true
  if [[ "$locked" == "1" ]]; then info "$(t lock_ok)" || true; else warn "$(t lock_fail)" || true; fi
  if [[ "$hard" == "1" ]]; then info "$(t now_hard)" || true; fi
}

cmd_status() {
  require_macos
  info "$(t status_header)"

  # Mounted disk images (vaults, dmg) — `panic now` would detach them.
  local images=() mp
  while IFS= read -r mp; do
    [[ -n "$mp" ]] && images+=("$mp")
  done < <(_mounted_images)
  if [[ ${#images[@]} -gt 0 ]]; then
    info "$(t status_images "${#images[@]}")"
    for mp in "${images[@]}"; do printf '    %s\n' "$mp"; done
  else
    info "$(t status_no_images)"
  fi

  # Clipboard — best-effort. Under `set -euo pipefail` a failing `pbpaste` (headless / no
  # pasteboard session) would return non-zero and abort the read-only status with code 1. We isolate
  # exactly the pbpaste failure via `|| pb_ok=0` (NOT the whole pipeline — otherwise a broken wc/tr
  # would silently yield "unknown" too); non-emptiness is checked directly with `[[ -n ]]`, no byte counting.
  local clip="" pb_ok=1
  clip="$(pbpaste 2>/dev/null)" || pb_ok=0
  if [[ "$pb_ok" == "0" ]]; then
    info "$(t status_clip_unknown)"
  elif [[ -n "$clip" ]]; then
    info "$(t status_clip_has)"
  else
    info "$(t status_clip_empty)"
  fi

  # FileVault — honest context.
  if filevault_on; then
    info "$(t status_fv_on)"
  else
    warn "$(t status_fv_off)"
  fi

  # Cloud daemons (--hard would kill them).
  local d
  for d in "${PANIC_CLOUD_DAEMONS[@]}"; do
    if pgrep -x "$d" >/dev/null 2>&1; then
      info "$(t status_cloud "$d")"
    fi
  done
}

# Remove panic's managed block from the skhd config (foreign lines untouched). awk compares
# lines literally — no fuss escaping special characters in the markers.
_hotkey_strip() {
  [[ -f "$SKHD_CONFIG" ]] || return 0
  local tmp; tmp="$(mktemp)" || return 1
  # We delete ONLY complete managed blocks (begin..end). An unclosed block (corrupted
  # config) is NOT cut to end-of-file — we buffer and put it back, so foreign lines are not wiped.
  awk -v b="$PANIC_HK_BEGIN" -v e="$PANIC_HK_END" '
    $0==b && !inblock { inblock=1; buf=$0 ORS; next }
    inblock { buf=buf $0 ORS; if ($0==e) { inblock=0; buf="" } next }
    { print }
    END { if (inblock) printf "%s", buf }
  ' "$SKHD_CONFIG" > "$tmp" || { rm -f "$tmp"; return 1; }
  # We pour the content into the existing file rather than swap it via mv: mv would bring
  # mktemp's permissions (600) and the current user's ownership onto someone else's skhdrc. The
  # copy of the foreign config is removed right away — no reason to leave it in TMPDIR (trap RETURN
  # is no good here: in bash it is global and would fire on the return of any other function).
  cat "$tmp" > "$SKHD_CONFIG"
  rm -f "$tmp"
}

# (Re)start the skhd service best-effort: for an already installed service restart suffices;
# on a clean system — install + start. Errors do not fail the command (skhd may require rights).
_hotkey_reload() {
  command -v skhd >/dev/null 2>&1 || return 0
  skhd --restart-service >/dev/null 2>&1 && return 0
  skhd --install-service >/dev/null 2>&1 || true
  skhd --start-service   >/dev/null 2>&1 || true
}

# Global panic hotkey via skhd. The hotkey launcher only invokes `panic now` —
# it touches no secrets. The config block is managed and does not clobber foreign skhd bindings.
cmd_hotkey() {
  require_macos
  local sub="${1:-status}"; shift || true
  case "$sub" in
    install)
      command -v skhd >/dev/null 2>&1 || { err "$(t hk_no_skhd)"; exit 1; }
      local combo="${1:-$PANIC_HOTKEY_COMBO}"
      # The combo must not contain ':' (skhd's separator) or a newline — otherwise extra
      # lines/bindings could be injected into skhdrc.
      if [[ "$combo" == *:* || "$combo" == *$'\n'* ]]; then err "$(t hk_bad_combo)"; exit 1; fi
      local self; self="$(_abspath "${BASH_SOURCE[0]}")"
      mkdir -p "$(dirname "$SKHD_CONFIG")"
      _hotkey_strip
      # Compute the separator BEFORE opening the redirect (otherwise shellcheck SC2094: read+write).
      local sep=""
      [[ -s "$SKHD_CONFIG" ]] && sep=$'\n'
      {
        printf '%s' "$sep"
        printf '%s\n' "$PANIC_HK_BEGIN"
        # The path is quoted: installs happen from paths with spaces (e.g. /Volumes/X10 Pro/...);
        # without quotes skhd would split the command on the space.
        printf '%s : "%s" now\n' "$combo" "$self"
        printf '%s\n' "$PANIC_HK_END"
      } >> "$SKHD_CONFIG"
      _hotkey_reload
      info "$(t hk_installed "$combo")"
      warn "$(t hk_accessibility)"
      ;;
    uninstall)
      _hotkey_strip
      _hotkey_reload
      info "$(t hk_uninstalled)"
      ;;
    status)
      if [[ -f "$SKHD_CONFIG" ]] && grep -qF "$PANIC_HK_BEGIN" "$SKHD_CONFIG"; then
        local line; line="$(grep -A1 -F "$PANIC_HK_BEGIN" "$SKHD_CONFIG" | tail -1)"
        info "$(t hk_status_on "$line")"
      else
        info "$(t hk_status_off)"
      fi
      command -v skhd >/dev/null 2>&1 || warn "$(t hk_no_skhd)"
      ;;
    *) err "$(t hk_usage)"; exit 1 ;;
  esac
}

cmd_version() { echo "panic $VERSION"; }

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then usage; exit 1; fi
  shift || true
  case "$cmd" in
    status)          cmd_status "$@" ;;
    version|-v|--version) cmd_version "$@" ;;
    help|--help|-h) usage ;;
    now)           cmd_now "$@" ;;
    hotkey)        cmd_hotkey "$@" ;;
    *) t unknown_cmd "$cmd" >&2; echo >&2; usage >&2; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
