usage() { t usage; }

# Hook directory — the same one securetrash reads (shared ecosystem contract).
ST_HOOK_DIR="${ST_HOOK_DIR:-${HOME}/.securetrash/hooks}"

# Managed-hook signature: this is how we tell our hooks from user-owned ones.
HOOK_SIGNATURE="# managed-by: vaultwatch"

# Absolute path to this script (embedded into hooks so we don't depend on PATH).
_self_path() {
  local src="${BASH_SOURCE[0]}"
  local dir
  dir="$(cd -P -- "$(dirname -- "$src")" 2>/dev/null && pwd -P)" || { printf '%s' "$src"; return; }
  printf '%s/%s' "$dir" "$(basename -- "$src")"
}

# Write one managed hook without clobbering a foreign one (lacking our signature).
_write_hook() {
  local name="$1" action="$2" self="$3"
  local path="${ST_HOOK_DIR}/${name}"
  if [[ -e "$path" ]] && ! grep -qF "$HOOK_SIGNATURE" "$path" 2>/dev/null; then
    warn "$(t hook_skip_foreign "$path")"
    return 0
  fi
  # Quote the path into a shell literal: robust to spaces/quotes/$ in the path.
  local qself; printf -v qself '%q' "$self"
  cat > "$path" <<EOF
#!/usr/bin/env bash
${HOOK_SIGNATURE}
# Called by securetrash vault ${name#post-}. \$1 = the mount point.
exec ${qself} ${action} "\$@"
EOF
  chmod +x "$path"
}

cmd_install_hooks() {
  # Installing hooks is just writing files — platform-independent. macOS is required
  # only by the start/stop core (mdutil/tmutil), which is where require_macos sits (pack 3b).
  mkdir -p "$ST_HOOK_DIR"
  local self; self="$(_self_path)"
  _write_hook post-open  start "$self"
  _write_hook post-close stop  "$self"
  info "$(t hooks_installed "$ST_HOOK_DIR")"
}

cmd_uninstall_hooks() {
  local name path removed=0
  for name in post-open post-close; do
    path="${ST_HOOK_DIR}/${name}"
    [[ -e "$path" ]] || continue
    if grep -qF "$HOOK_SIGNATURE" "$path" 2>/dev/null; then
      rm -f "$path"; removed=1
    else
      warn "$(t hook_skip_rm "$path")"
    fi
  done
  if [[ "$removed" == "1" ]]; then info "$(t hooks_removed "$ST_HOOK_DIR")"; fi
  return 0
}

# --- guard core (pack 3b): start / stop ----------------------------------

# Session state directory. Each open session = one file (key=value), so that
# stop restores EXACTLY what start changed (rather than "everything in sight").
VW_STATE_DIR="${VW_STATE_DIR:-${HOME}/.vaultwatch/sessions}"

# LaunchAgents directory for the --ttl timer (launchd-managed). Overridden in tests.
VW_LAUNCH_DIR="${VW_LAUNCH_DIR:-${HOME}/Library/LaunchAgents}"

# Known cloud daemons: "process_name|label|sync-folder[:another-folder]".
# pgrep -x matches the exact process name; folders feed the inside/outside heuristic.
# Honest: this is a heuristic (daemons/folders change), not telepathy — and we report it as such.
_cloud_table() {
  cat <<EOF
Dropbox|Dropbox|${HOME}/Dropbox
OneDrive|OneDrive|${HOME}/OneDrive:${HOME}/Library/CloudStorage/OneDrive
bird|iCloud Drive|${HOME}/Library/Mobile Documents:${HOME}/Library/CloudStorage/iCloud
Google Drive|Google Drive|${HOME}/Library/CloudStorage/GoogleDrive:${HOME}/Google Drive
EOF
}

# Path to the session state file for a given mountpoint.
# The file name is the sanitized mount (collision resistance is not critical:
# only a handful of vaults are ever open, the original is stored inside the file).
# Does the session carry an unpaid indexing debt (stop failed — the volume was gone)?
_state_pending_restore() {
  local sf; sf="$(_state_file "$1")"
  [[ -f "$sf" ]] || return 1
  grep -q '^pending_restore=1$' "$sf"
}

_state_file() {
  local mount="$1" safe
  safe="$(printf '%s' "$mount" | tr -c 'a-zA-Z0-9' '_')"
  printf '%s/%s' "$VW_STATE_DIR" "$safe"
}

# Is child inside parent? (both already canonicalized) — exact match or a '/'-prefixed prefix.
_is_inside() {
  local child="$1" parent="$2"
  [[ "$child" == "$parent" || "$child" == "$parent/"* ]]
}

# Cloud detection (detection only): one line per active daemon as "SEV\tText",
# SEV = ok|warn (warn = vault is INSIDE the sync folder — leak risk). "Honest about
# the heuristic": we look at running processes + folder locations, not telepathy.
_cloud_lines() {
  local mount="$1" proc label folders f inside cf
  while IFS='|' read -r proc label folders; do
    [[ -n "$proc" ]] || continue
    pgrep -x "$proc" >/dev/null 2>&1 || continue
    inside=0
    IFS=':' read -ra _f <<<"$folders"
    for f in "${_f[@]}"; do
      [[ -n "$f" ]] || continue
      cf="$(_abspath "$f" 2>/dev/null)" || continue
      if _is_inside "$mount" "$cf"; then inside=1; break; fi
    done
    if [[ "$inside" == "1" ]]; then printf 'warn\t%s\n' "$(t cloud_inside "$label")"
    else printf 'ok\t%s\n' "$(t cloud_outside "$label")"; fi
  done < <(_cloud_table)
}

# Presentation of the cloud detection for `start`: ok→info, warn→warn.
_report_cloud_start() {
  local sev text
  while IFS=$'\t' read -r sev text; do
    [[ -n "$text" ]] || continue
    if [[ "$sev" == "warn" ]]; then warn "$text"; else info "$text"; fi
  done < <(_cloud_lines "$1")
}

# Mountpoint argument: valid and canonicalized, or exit with an error.
_require_mount() {
  local raw="${1:-}" canon
  if [[ -z "$raw" ]]; then err "$(t need_mount)"; exit 1; fi
  if [[ ! -d "$raw" ]]; then err "$(t mount_missing "$raw")"; exit 1; fi
  canon="$(_abspath "$raw")" || { err "$(t mount_missing "$raw")"; exit 1; }
  printf '%s' "$canon"
}

# Duration ("30m"/"2h"/"45s"/"1d"/bare seconds) → seconds. Non-zero on garbage.
_parse_duration() {
  local s="${1:-}" n unit
  [[ "$s" =~ ^([0-9]+)([smhd]?)$ ]] || return 1
  n="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
  case "$unit" in
    s|"") printf '%s' "$n" ;;
    m)    printf '%s' "$((n * 60))" ;;
    h)    printf '%s' "$((n * 3600))" ;;
    d)    printf '%s' "$((n * 86400))" ;;
  esac
}

# --- launchd timer for --ttl (pack 3d) ------------------------------------
# One-shot job: RunAtLoad=true → starts on load, sleeps ttl_secs, calls
# `_ttl_fire <mount>` and exits (no KeepAlive → it is not restarted).
# launchd-managed: visible in `launchctl list`, survives the parent shell
# exiting, and is cleanly removed via bootout.

_ttl_label()      { printf 'com.vaultwatch.ttl.%s' "$(printf '%s' "$1" | tr -c 'a-zA-Z0-9' '_')"; }
_ttl_plist_path() { printf '%s/%s.plist' "$VW_LAUNCH_DIR" "$(_ttl_label "$1")"; }
_ttl_domain()     { printf 'gui/%s' "$(id -u)"; }

# Minimal XML escaping for paths inside the plist.
_xml_escape() {
  local s="$1"
  s="${s//&/&amp;}"; s="${s//</&lt;}"; s="${s//>/&gt;}"; s="${s//\"/&quot;}"
  printf '%s' "$s"
}

# Write + load the LaunchAgent; prints the Label (to be recorded in state).
_ttl_schedule() {
  local mount="$1" secs="$2" label plist self
  label="$(_ttl_label "$mount")"
  plist="$(_ttl_plist_path "$mount")"
  self="$(_self_path)"
  mkdir -p "$VW_LAUNCH_DIR"
  # ProgramArguments: bash -c with positional $1/$2/$3 — unfazed by spaces in the path.
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(_xml_escape "$label")</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>sleep "\$1"; exec "\$2" _ttl_fire "\$3"</string>
    <string>vaultwatch-ttl</string>
    <string>$(_xml_escape "$secs")</string>
    <string>$(_xml_escape "$self")</string>
    <string>$(_xml_escape "$mount")</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
EOF
  local dom; dom="$(_ttl_domain)"
  launchctl bootout "$dom" "$plist" >/dev/null 2>&1 || true   # remove a possible stale one
  if ! launchctl bootstrap "$dom" "$plist" >/dev/null 2>&1; then
    warn "$(t ttl_sched_fail)"
    rm -f "$plist"
    return 0  # not fatal; warn printed, stdout empty → caller gets an empty label
  fi
  printf '%s' "$label"
}

# Remove the LaunchAgent (bootout) and delete the plist. Idempotent.
_ttl_remove() {
  local mount="$1" plist dom
  plist="$(_ttl_plist_path "$mount")"
  dom="$(_ttl_domain)"
  launchctl bootout "$dom" "$plist" >/dev/null 2>&1 || true
  rm -f "$plist"
}

# --- unmount-guard: auto-restore of exclusions when the volume vanishes bypassing `vaultwatch stop` ---
# Why: a Finder eject (or any detach bypassing the securetrash post-close hook) leaves
# Spotlight-off and the Time Machine exclusion hanging until the next explicit stop. launchd
# WatchPaths on the mountpoint fires on ANY change to the path (incl. its disappearance on
# unmount), invoking `_guard_fire <mount>`. That one runs the restore ONLY if the volume is
# really gone (otherwise WatchPaths fired on a file write inside — no-op). WatchPaths, NOT
# RunAtLoad: don't fire at load time.
_guard_label()      { printf 'com.vaultwatch.guard.%s' "$(printf '%s' "$1" | tr -c 'a-zA-Z0-9' '_')"; }
_guard_plist_path() { printf '%s/%s.plist' "$VW_LAUNCH_DIR" "$(_guard_label "$1")"; }

# Write + load the guard LaunchAgent; prints the Label (to be recorded in state).
_guard_schedule() {
  local mount="$1" label plist self dom
  label="$(_guard_label "$mount")"
  plist="$(_guard_plist_path "$mount")"
  self="$(_self_path)"
  mkdir -p "$VW_LAUNCH_DIR"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(_xml_escape "$label")</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "\$1" _guard_fire "\$2"</string>
    <string>vaultwatch-guard</string>
    <string>$(_xml_escape "$self")</string>
    <string>$(_xml_escape "$mount")</string>
  </array>
  <key>WatchPaths</key>
  <array><string>$(_xml_escape "$mount")</string></array>
</dict>
</plist>
EOF
  dom="$(_ttl_domain)"
  launchctl bootout "$dom" "$plist" >/dev/null 2>&1 || true
  if ! launchctl bootstrap "$dom" "$plist" >/dev/null 2>&1; then
    warn "$(t guard_sched_fail)"
    rm -f "$plist"
    return 0   # not fatal: warn printed, empty stdout → caller does not write guard_label
  fi
  printf '%s' "$label"
}

# Remove the guard LaunchAgent. Idempotent.
_guard_remove() {
  local mount="$1" plist dom
  plist="$(_guard_plist_path "$mount")"
  dom="$(_ttl_domain)"
  launchctl bootout "$dom" "$plist" >/dev/null 2>&1 || true
  rm -f "$plist"
}

cmd_start() {
  require_macos
  local ttl_secs=0 ttl_force=0 raw=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ttl)   shift
               ttl_secs="$(_parse_duration "${1:-}")" || { err "$(t ttl_bad "${1:-}")"; exit 1; }
               shift ;;
      --force) ttl_force=1; shift ;;
      --)      shift; raw="${1:-}"; break ;;
      -*)      err "$(t unknown_cmd "$1")"; exit 1 ;;
      *)       raw="$1"; shift ;;
    esac
  done
  local mount; mount="$(_require_mount "$raw")"
  # Set when the previous session's debt could not be paid off: the true pre-session
  # indexing state is "enabled", and the new session must carry that along.
  local carry_spot_enabled=0

  # Session already exists for this mount? A repeated start would overwrite the saved
  # pre-session state with the current one (Spotlight already off, TM already excluded) →
  # stop would not restore the original (Spotlight OFF forever, volume out of Time Machine).
  # We refuse idempotently (P2-6).
  if [[ -f "$(_state_file "$mount")" ]]; then
    # Session with an unfinished restore: the previous stop could not turn indexing back
    # on because the volume had already been unmounted by then (the normal path — securetrash
    # closes the vault BEFORE invoking the post-close hook). The setting lives on the volume
    # itself and survives remounting, so the debt has been waiting for exactly this moment:
    # the volume is in front of us again. Pay off the debt and continue with a normal start —
    # otherwise the exclusion would remain forever and the ghost session would block watching.
    if _state_pending_restore "$mount" && ! _vault_gone "$mount"; then
      if mdutil -i on "$mount" >/dev/null 2>&1; then
        info "$(t restore_finished "$mount")"
      else
        # Could not pay it off (mdutil refused). We do NOT lose the debt: before us,
        # indexing was ENABLED, and the new session must carry that knowledge along,
        # otherwise its stop would "restore" a "was disabled" state — and the exclusion
        # would silently become permanent.
        warn "$(t restore_spot_fail "$mount")"
        carry_spot_enabled=1
      fi
      rm -f "$(_state_file "$mount")"
    else
      warn "$(t already_watching "$mount")"
      return 0
    fi
  fi

  # Spotlight: remember the previous state, then turn indexing off.
  local spot_was=unknown
  if mdutil -s "$mount" 2>/dev/null | grep -qi "Indexing enabled"; then
    spot_was=enabled
  elif mdutil -s "$mount" 2>/dev/null | grep -qi "Indexing disabled"; then
    spot_was=disabled
  fi
  # An unpaid debt trumps what we observe now: it reads "disabled" now precisely because
  # we disabled it and could not turn it back on.
  [[ "$carry_spot_enabled" == "1" ]] && spot_was=enabled
  mdutil -i off "$mount" >/dev/null 2>&1 || true

  # Time Machine: exclude only if not excluded yet (otherwise stop leaves it alone).
  local tm_added=0
  if tmutil isexcluded "$mount" 2>/dev/null | grep -qi "\[Included\]"; then
    tmutil addexclusion "$mount" >/dev/null 2>&1 && tm_added=1
  fi

  # Session state — so that stop restores exactly what was changed.
  mkdir -p "$VW_STATE_DIR"
  local sf; sf="$(_state_file "$mount")"
  {
    printf 'mount=%s\n' "$mount"
    printf 'started=%s\n' "$(date +%s)"
    printf 'spotlight_was=%s\n' "$spot_was"
    printf 'tm_added=%s\n' "$tm_added"
    printf 'ttl_secs=%s\n' "$ttl_secs"
    printf 'ttl_force=%s\n' "$ttl_force"
  } > "$sf"

  # Timed auto-exit via a launchd LaunchAgent. VW_NO_SPAWN=1 suppresses the actual
  # load (state unit tests). The Label goes into state — stop will remove it.
  if [[ "$ttl_secs" -gt 0 && "${VW_NO_SPAWN:-0}" != "1" ]]; then
    local label; label="$(_ttl_schedule "$mount" "$ttl_secs")"
    printf 'ttl_label=%s\n' "$label" >> "$sf"
  fi

  # unmount-guard: always (not only with TTL) — so a Finder eject bypassing stop also
  # auto-restores the exclusions. VW_NO_SPAWN=1 suppresses the actual load (unit tests).
  if [[ "${VW_NO_SPAWN:-0}" != "1" ]]; then
    local glabel; glabel="$(_guard_schedule "$mount")"
    [[ -n "$glabel" ]] && printf 'guard_label=%s\n' "$glabel" >> "$sf"
  fi

  info "$(t watching "$mount")"
  [[ "$ttl_secs" -gt 0 ]] && info "$(t ttl_scheduled "$(_fmt_duration "$ttl_secs")")"
  _report_cloud_start "$mount"
}

# Seconds → human-readable duration ("Hh Mm Ss" / "Mm Ss").
_fmt_duration() {
  local s="$1" h m
  h=$((s / 3600)); m=$(((s % 3600) / 60)); s=$((s % 60))
  if (( h > 0 )); then printf '%dh %dm %ds' "$h" "$m" "$s"
  else printf '%dm %ds' "$m" "$s"; fi
}

cmd_stop() {
  require_macos
  local raw="${1:-}"
  if [[ -z "$raw" ]]; then err "$(t need_mount)"; exit 1; fi
  # On close the vault is already unmounted — the directory may not exist; do NOT require -d.
  # ASSUMPTION: path has no symlinks (typical for /Volumes/X) → the key matches start's.
  local mount; mount="$(_abspath "$raw" 2>/dev/null || printf '%s' "$raw")"
  local sf; sf="$(_state_file "$mount")"
  if [[ ! -f "$sf" ]]; then
    warn "$(t no_session "$mount")"
    return 0
  fi

  # Read the session state (parse, not source — shellcheck-clean and safer).
  local started=0 spot_was=unknown tm_added=0 ttl_label="" k v
  while IFS='=' read -r k v; do
    case "$k" in
      started)       started="$v" ;;
      spotlight_was) spot_was="$v" ;;
      tm_added)      tm_added="$v" ;;
      ttl_label)     ttl_label="$v" ;;
    esac
  done < "$sf"

  # Remove the auto-exit launchd timer (the vault was closed manually before the TTL,
  # or this call comes from _ttl_fire itself — booting out one's own job is safe).
  [[ -n "$ttl_label" ]] && _ttl_remove "$mount"
  # Remove the unmount-guard UNCONDITIONALLY (not keyed on guard_label): the plist path is
  # deterministic from the mount, so an unconditional bootout+rm is idempotent and closes
  # (a) the race "guard loaded but its label not yet written to state between bootstrap and
  # printf", (b) any stale plist from a previous start. Including the case where the guard
  # itself triggered this stop (booting out one's own job is safe, same as with TTL).
  _guard_remove "$mount"

  # Restore EXACTLY what we changed. Check the result: on failure, keep the state
  # file so the restore can be retried after the vault is remounted.
  local restore_ok=1 spot_na=0
  if [[ "$spot_was" == "enabled" ]]; then
    if _vault_gone "$mount"; then
      # Volume is unmounted (e.g. Finder eject + guard) — there is nothing to re-enable
      # indexing on, restore is N/A, and that is NOT an error: we clean up the session,
      # otherwise a stale state file would block the next start forever. A leftover
      # directory in the volume's place lands here too. But we must not claim "turned it
      # back on" either: the setting remains on the volume itself and will survive a
      # remount, so the report must say so in plain words.
      spot_na=1
    elif ! mdutil -i on "$mount" >/dev/null 2>&1; then
      warn "$(t restore_spot_fail "$mount")"
      restore_ok=0
    fi
  fi
  if [[ "$tm_added" == "1" ]]; then
    tmutil removeexclusion "$mount" >/dev/null 2>&1 || true  # works even when unmounted
  fi

  # --- session report ---
  local now dur; now="$(date +%s)"; dur=$((now - started))
  printf '%s\n' "$(t rep_header)"
  printf '%s\n' "$(t rep_duration "$(_fmt_duration "$dur")")"
  if [[ "$spot_was" != "enabled" ]]; then printf '%s\n' "$(t rep_spot_keep)"
  elif [[ "$spot_na" == "1" ]]; then printf '%s\n' "$(t rep_spot_na)"
  else printf '%s\n' "$(t rep_spot_on "$mount")"; fi
  if [[ "$tm_added" == "1" ]]; then printf '%s\n' "$(t rep_tm_removed)"
  else printf '%s\n' "$(t rep_tm_keep)"; fi
  local cloud ln; cloud="$(_cloud_lines "$mount" | cut -f2-)"
  if [[ -n "$cloud" ]]; then
    while IFS= read -r ln; do printf '  cloud daemons:   %s\n' "$ln"; done <<<"$cloud"
  else printf '%s\n' "$(t rep_cloud_none)"; fi
  local nsnap; nsnap="$(tmutil listlocalsnapshots / 2>/dev/null | grep -c 'com.apple.TimeMachine' || true)"
  if [[ "${nsnap:-0}" -gt 0 ]]; then printf '%s\n' "$(t rep_snap_some "$nsnap")"
  else printf '%s\n' "$(t rep_snap_none)"; fi
  printf '%s\n' "$(t rep_swap)"

  if [[ "$spot_na" == "1" ]]; then
    # The restore is still owed: we were the ones who disabled indexing, and it can only
    # be re-enabled on a mounted volume. We do NOT delete the session — otherwise the
    # report's advice ("mount it and run stop") is unactionable, the next start knows
    # nothing about the debt, and the exclusion stays on the volume forever. We rewrite
    # the file: the timer and the guard are already removed, only the debt itself remains.
    printf 'mount=%s\nstarted=%s\nspotlight_was=enabled\ntm_added=0\npending_restore=1\n' "$mount" "$started" > "$sf"
  elif [[ "$restore_ok" == "1" ]]; then
    rm -f "$sf"
  else
    warn "$(t restore_incomplete "$mount")"
    # A non-zero exit code is mandatory: a stop that failed to restore the exclusions is
    # not a success. Otherwise the securetrash post-close hook and the launchd timer would
    # consider the session closed, while Spotlight still isn't indexing the volume and the
    # state file is still alive.
    return 1
  fi
}

# Internal command: fires when --ttl expires (from the background timer).
# Honest about the boundary: hdiutil detach won't unmount a volume with open files.
# Files busy → warn and do NOT touch it (unless --force with confirm).
cmd_ttl_fire() {
  require_macos
  local raw="${1:-}"; [[ -n "$raw" ]] || return 0
  local mount; mount="$(_abspath "$raw" 2>/dev/null || printf '%s' "$raw")"
  local sf; sf="$(_state_file "$mount")"
  [[ -f "$sf" ]] || return 0   # no session (closed manually) — stay quiet

  local ttl_force=0 k v
  while IFS='=' read -r k v; do
    [[ "$k" == "ttl_force" ]] && ttl_force="$v"
  done < "$sf"

  if lsof "$mount" >/dev/null 2>&1; then
    # The volume is busy with open files.
    if [[ "$ttl_force" == "1" ]] && confirm "$(t ttl_force_confirm "$mount")"; then
      hdiutil detach -force "$mount" >/dev/null 2>&1 || true
    else
      warn "$(t ttl_busy "$mount")"
      return 0
    fi
  else
    hdiutil detach "$mount" >/dev/null 2>&1 || true
  fi

  # Verify the vault is really unmounted (hdiutil || true guarantees nothing).
  # Ask the mount table: a directory left behind after detach is not an open vault.
  if ! _vault_gone "$mount"; then
    warn "$(t ttl_detach_fail "$mount")"
    return 1
  fi
  cmd_stop "$mount"
}

# Internal command: fires via launchd WatchPaths when the mountpoint changes.
# WatchPaths fires on ANY change to the path (incl. a file write inside the open volume),
# so we run the restore ONLY when the volume is really gone (unmounted). Otherwise — no-op.
cmd_guard_fire() {
  require_macos
  local raw="${1:-}"; [[ -n "$raw" ]] || return 0
  local mount; mount="$(_abspath "$raw" 2>/dev/null || printf '%s' "$raw")"
  # The volume is still mounted (or we could not find out) → WatchPaths fired on a
  # content change, not an eject. Exit quietly, don't touch the exclusion.
  _vault_gone "$mount" || return 0
  # The volume is gone (Finder eject / detach bypassing stop) → restore the exclusions and clean up the session.
  cmd_stop "$mount"
}

cmd_status() {
  require_macos
  local sf mount started spot_was tm_added ttl_secs k v found=0
  if [[ -d "$VW_STATE_DIR" ]]; then
    for sf in "$VW_STATE_DIR"/*; do
      [[ -f "$sf" ]] || continue
      found=1
      mount="" started=0 spot_was=unknown tm_added=0 ttl_secs=0
      while IFS='=' read -r k v; do
        case "$k" in
          mount)         mount="$v" ;;
          started)       started="$v" ;;
          spotlight_was) spot_was="$v" ;;
          tm_added)      tm_added="$v" ;;
          ttl_secs)      ttl_secs="$v" ;;
        esac
      done < "$sf"
      local now elapsed; now="$(date +%s)"; elapsed=$((now - started))
      info "$(t status_session "$mount") (running $(_fmt_duration "$elapsed"))"
      info "$(t status_spot "$spot_was")"
      if [[ "$tm_added" == "1" ]]; then info "$(t status_tm)"; fi
      if [[ "${ttl_secs:-0}" -gt 0 ]]; then
        local remaining=$(( started + ttl_secs - now ))
        if [[ "$remaining" -gt 0 ]]; then info "$(t status_ttl "$(_fmt_duration "$remaining")")"; fi
      fi
    done
  fi
  if [[ "$found" == "0" ]]; then info "$(t status_no_sessions)"; fi
}

cmd_version() { echo "vaultwatch $VERSION"; }

main() {
  # --yes anywhere in the arguments == ST_ASSUME_YES=1 (same contract as securetrash:
  # previously the --ttl --force confirmation could only be bypassed via env). The flag
  # is cut out, the order of the remaining arguments is preserved.
  # After `--` arguments are literal: `start -- --yes` is a mountpoint with that name,
  # not a flag (an escape that cmd_start already supports).
  local args=() a literal=0
  for a in "$@"; do
    if [[ "$literal" == 0 && "$a" == "--yes" ]]; then ST_ASSUME_YES=1; continue; fi
    [[ "$a" == "--" ]] && literal=1
    args+=("$a")
  done
  set -- "${args[@]:-}"
  # An empty array expands to a single empty string — normalize to "no arguments".
  if [[ $# -eq 1 && -z "${1:-}" ]]; then set --; fi

  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then usage; exit 1; fi
  shift || true
  case "$cmd" in
    install-hooks)   cmd_install_hooks "$@" ;;
    uninstall-hooks) cmd_uninstall_hooks "$@" ;;
    version|-v|--version) cmd_version "$@" ;;
    help|-h|--help)  usage ;;
    status)          cmd_status "$@" ;;
    start)           cmd_start "$@" ;;
    stop)            cmd_stop "$@" ;;
    _ttl_fire)       cmd_ttl_fire "$@" ;;   # internal: invoked by the background TTL timer
    _guard_fire)     cmd_guard_fire "$@" ;; # internal: invoked by launchd WatchPaths on unmount
    *) t unknown_cmd "$cmd" >&2; echo >&2; usage >&2; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
