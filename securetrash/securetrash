    ru:vault_mounted)    printf 'Смонтировано: %s' "$1" ;;

    en:vault_detach_fail) echo "Could not unmount (not open?)." ;;
    ru:vault_detach_fail) echo "Не удалось размонтировать (не открыт?)." ;;

    en:vault_closed)     echo "Unmounted — data is encrypted again." ;;
    ru:vault_closed)     echo "Размонтировано — данные снова зашифрованы." ;;

    en:vault_no_container) printf 'No container: %s' "$1" ;;
    ru:vault_no_container) printf 'Нет контейнера: %s' "$1" ;;

    en:vault_bad_container) printf 'Not a valid vault container (expected an encrypted sparsebundle): %s' "$1" ;;
    ru:vault_bad_container) printf 'Невалидный контейнер (ожидается зашифрованный sparsebundle): %s' "$1" ;;
    en:vault_bad_size) printf 'Invalid size: %s (use e.g. 500m, 1g, 2t)' "$1" ;;
    ru:vault_bad_size) printf 'Неверный размер: %s (например 500m, 1g, 2t)' "$1" ;;

    en:vault_create_fail) printf 'Could not create the container (%s).' "$1" ;;
    ru:vault_create_fail) printf 'Не удалось создать контейнер (%s).' "$1" ;;

    en:vault_aside_exists) printf 'A previous container is still set aside at %s — an interrupted reset, or your own backup. It holds real data, so it will not be removed automatically. Move or delete it yourself, then run reset again.' "$1" ;;
    ru:vault_aside_exists) printf 'Рядом лежит отставленный контейнер %s — прерванный reset или твой бэкап. В нём реальные данные, автоматически он не удаляется. Убери или удали его сам, затем повтори reset.' "$1" ;;

    en:vault_aside_notice) printf 'Note: %s is on disk — a container set aside by an interrupted reset. Your older data is in there, not in the active vault. Open it to get the data back: hdiutil attach %s. Destroy it for good: securetrash vault destroy-old.' "$1" "$1" ;;
    ru:vault_aside_notice) printf 'Внимание: на диске лежит %s — контейнер, отставленный прерванным reset. Прежние данные там, а не в активном сейфе. Открыть и забрать данные: hdiutil attach %s. Уничтожить насовсем: securetrash vault destroy-old.' "$1" "$1" ;;

    en:vault_old_none)   printf 'Nothing is set aside: %s does not exist.' "$1" ;;
    ru:vault_old_none)   printf 'Отставленного контейнера нет: %s не существует.' "$1" ;;

    en:vault_old_confirm) printf 'DESTROY the set-aside container and everything inside (%s)?' "$1" ;;
    ru:vault_old_confirm) printf 'УНИЧТОЖИТЬ отставленный контейнер и всё внутри (%s)?' "$1" ;;

    en:vault_old_destroyed) printf 'Set-aside container removed (crypto-shred): %s.' "$1" ;;
    ru:vault_old_destroyed) printf 'Отставленный контейнер удалён (crypto-shred): %s.' "$1" ;;

    en:vault_reset_rolled_back) printf 'Reset rolled back: the previous vault is back in place (%s). Nothing was destroyed.' "$1" ;;
    ru:vault_reset_rolled_back) printf 'Reset откачен: прежний сейф вернулся на место (%s). Ничего не уничтожено.' "$1" ;;

    en:vault_restore_fail) printf 'Could not move the vault back. Your data is NOT lost — it is at %s. Move it to %s manually.' "$1" "$2" ;;
    ru:vault_restore_fail) printf 'Не удалось вернуть сейф на место. Данные НЕ потеряны — они в %s. Перенеси их в %s вручную.' "$1" "$2" ;;

    en:vault_aside_busy) printf 'The old container at %s appears to be MOUNTED — refusing to crypto-shred a live decrypted volume. Eject it, then delete %s yourself. The new vault is already in place.' "$1" "$1" ;;
    ru:vault_aside_busy) printf 'Старый контейнер %s выглядит СМОНТИРОВАННЫМ — не уничтожаю живой расшифрованный том. Извлеки его и удали %s сам. Новый сейф уже на месте.' "$1" "$1" ;;

    en:vault_aside_left) printf 'The new vault was created, but the old container could NOT be removed: %s is still on disk and is still decryptable with the old password. Delete it yourself — until then the crypto-shred promise does not hold.' "$1" ;;
    ru:vault_aside_left) printf 'Новый сейф создан, но старый контейнер удалить НЕ удалось: %s остался на диске и по-прежнему расшифровывается старым паролем. Удали его сам — до этого обещание crypto-shred не выполнено.' "$1" ;;

    en:vault_destroy_confirm) printf 'DESTROY the container and everything inside (%s)?' "$1" ;;
    ru:vault_destroy_confirm) printf 'УНИЧТОЖИТЬ контейнер и всё внутри (%s)?' "$1" ;;

