  esac
}

# --- output helpers ---
if [[ -t 1 ]]; then
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_RST=$'\033[0m'
else
  C_RED=""; C_GRN=""; C_YEL=""; C_RST=""
fi
info()  { echo "${C_GRN}✓${C_RST} $*"; }
warn()  { echo "${C_YEL}!${C_RST} $*" >&2; }
err()   { echo "${C_RED}✗${C_RST} $*" >&2; }

# Ask for confirmation. ST_ASSUME_YES=1 skips the question (for scripts/tests).
confirm() {
  local prompt="$1"
  local ans
  if [[ "${ST_ASSUME_YES:-0}" == "1" ]]; then return 0; fi
  read -r -p "$prompt $(t confirm_suffix): " ans
  [[ "$ans" == "yes" ]]
}

# --- platform detection ---
# Is the disk under the path an SSD? (diskutil info: "Solid State: Yes")
is_ssd() {
  local path="${1:-/}"
  diskutil info "$path" 2>/dev/null | grep -qi "Solid State:.*Yes"
}

# Kind of disk under the path: ssd | hdd | unknown.
# unknown — when diskutil gave no clear answer (no "Solid State" field).
# Honesty over guessing: an unknown kind is NOT treated as HDD-effective.
_disk_kind() {
  local path="${1:-/}"
  local out
  out="$(diskutil info "$path" 2>/dev/null)"
  if grep -qi "Solid State:.*Yes" <<<"$out"; then
    echo "ssd"
  elif grep -qi "Solid State:.*No" <<<"$out"; then
    echo "hdd"
  else
    echo "unknown"
  fi
}

# Tri-state FileVault: on / off / unknown. Distinguishes "off" from "could not determine"
# (fdesetup unavailable / unintelligible output), so that `check` does not print a false
# "OFF" when the status is actually unknown. Mirror of the canonical `lib/common.sh:_fv_state`
# — securetrash predates the library and does not consume it, so the copy is kept in sync by hand.
_fv_state() {
  command -v fdesetup >/dev/null 2>&1 || { echo unknown; return; }
  local s; s="$(fdesetup status 2>/dev/null)"
  if   grep -qi "FileVault is On"  <<<"$s"; then echo on
  elif grep -qi "FileVault is Off" <<<"$s"; then echo off
  else echo unknown; fi
}

# Is FileVault on? Binary wrapper over _fv_state for places where "undetermined"
# is safe to treat as "not on" (fail-closed).
filevault_on() {
  [[ "$(_fv_state)" == on ]]
}

require_macos() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    err "$(t only_macos)"
    exit 1
  fi
}

usage() {
  t usage
}

# The SecureTrash "trash" folder. HOME is read at process start.
TRASH_DIR="${HOME}/SecureTrash"

# The encrypted sparsebundle container and its mount point.
# ST_VAULT_PATH / ST_VAULT_VOLUME let a GUI/TUI (the paranoid launcher reads the same env)
# point at a non-standard vault — otherwise status/open/reset/destroy would silently work
# on the default while the UI shows a custom one (see AUDIT_2026-07-03 P0-1). Defaults match the launcher.
VAULT_PATH="${ST_VAULT_PATH:-${HOME}/SecureVault.sparsebundle}"
VAULT_VOLUME="${ST_VAULT_VOLUME:-/Volumes/SecretVault}"

# Vault lifecycle hook directory. Through these, Paranoid Tools ecosystem
# utilities (vaultwatch/panic) plug into open/close without patching the securetrash core.
ST_HOOK_DIR="${ST_HOOK_DIR:-${HOME}/.securetrash/hooks}"

# Run the event hook (post-open/post-close) if it exists and is executable.
# A hook failure does NOT fail the vault operation: hooks are optional integration, warn only.
_run_vault_hook() {
  local event="$1"; shift
  local hook="${ST_HOOK_DIR}/${event}"
  [[ -x "$hook" ]] || return 0
  "$hook" "$@" || warn "$(t vault_hook_failed "$event")"
}

cmd_version() { echo "securetrash $VERSION"; }

# Environment setup: trash folder, alias, FileVault warning.
cmd_setup() {
  require_macos
  # 0700: plaintext may sit in the folder until empty — restrict access to the owner.
  mkdir -p "$TRASH_DIR" && chmod 700 "$TRASH_DIR"
  info "$(t setup_dir_ready "$TRASH_DIR")"

  local zshrc="${HOME}/.zshrc"
  local alias_line="alias sectrash='securetrash empty'"
  if [[ -f "$zshrc" ]] && grep -q "alias sectrash=" "$zshrc"; then
    info "$(t alias_present)"
  else
    echo "$alias_line" >> "$zshrc"
    info "$(t alias_added)"
  fi

  if ! filevault_on; then
    warn "$(t fv_off_setup)"
  fi
}

# Environment audit: an honest verdict on deletion guarantees.
cmd_check() {
  require_macos
  t check_header

  case "$(_fv_state)" in
    on)  info "$(t fv_on)" ;;
    off) warn "$(t fv_off_check)" ;;
    *)   warn "$(t fv_unknown_check)" ;;   # undetermined → conservative, assume unprotected
  esac

  case "$(_disk_kind /)" in
    ssd)
      t disk_ssd
      warn "$(t ssd_no_guarantee)"
      info "$(t ssd_real_guarantee)"
      ;;
    hdd)
      t disk_hdd
      info "$(t hdd_effective)"
      ;;
    *)
      t disk_unknown
      warn "$(t unknown_no_guarantee)"
      ;;
  esac

  _snapshot_note

  echo
  t check_verdict
}

# Delete a single path: lift write-protection, overwrite (best-effort), delete.
_shred_path() {
  local target="$1"
  # -- guards against names starting with a dash (the option parser would eat them otherwise).
  chmod -R u+w -- "$target" 2>/dev/null || true
  # -P: overwrite on HDD (best-effort); harmless on SSD, but not a guarantee.
  rm -rfP -- "$target"
}

# How many local Time Machine snapshots the system holds. A snapshot that caught the file
# BEFORE deletion stores it IN FULL — no shred can reach into it, and a single file cannot
# be removed from a snapshot, only the snapshot as a whole. Count only `com.apple.TimeMachine.*`:
# `com.apple.os.update-*` are installer rollback points, not document history.
# Prints a number, or "unknown" if tmutil is unavailable/refused (fail-closed in spirit).
# Mount point of the volume the path lives on. Empty if it could not be determined.
_mount_point() {
  df -P -- "${1:-/}" 2>/dev/null | awk 'NR==2{for(i=6;i<=NF;i++) printf "%s%s", $i, (i<NF?" ":"")}'
}

_snapshot_count() {
  local out n mp
  # Count the snapshots of THE volume the target lived on, not always the boot volume.
  mp="${1:-/}"
  # Could not determine the volume — more honest to say "unknown" than to count the
  # boot disk's snapshots and cheerfully report "no snapshots" for someone else's volume.
  [[ -n "$mp" ]] || { printf 'unknown'; return; }
  out="$(tmutil listlocalsnapshots "$mp" 2>/dev/null)" || { printf 'unknown'; return; }
  # Count ALL snapshots except the header and installer rollback points. An allowlist of
  # `com.apple.TimeMachine.*` won't do: snapshots by Carbon Copy Cloner, Arq and
  # the like hold exactly the same full copy, and an allowlist would miss them and
  # cheerfully report "no snapshots" — fail-open precisely where it must not.
  n="$(printf '%s\n' "$out" | grep -c '^com\.apple\.os\.update-\|^Snapshots for' || true)"
  local total; total="$(printf '%s\n' "$out" | grep -c '[^[:space:]]' || true)"
  printf '%s' "$(( ${total:-0} - ${n:-0} ))"
}

# Honest note about snapshots: the main channel through which a "wiped" file survives.
_snapshot_note() {
  local n; n="$(_snapshot_count "${1:-/}")"
  case "$n" in
    unknown) warn "$(t snap_unknown)" ;;
    0)       info "$(t snap_none)" ;;
    *)       warn "$(t snap_present "$n")" ;;
  esac
}

# Honest note on guarantees by the kind of disk under a specific path.
# Takes the target path (default /) so it judges the target's volume, not always /.
_honest_disk_note() {
  local target="${1:-/}"
  # The mount point may be captured beforehand (shred deletes the target before the note).
  local mp="${2:-}"; [[ -n "$mp" ]] || mp="$(_mount_point "$target")"
  case "$(_disk_kind "$target")" in
    ssd)
      warn "$(t ssd_note)"
      if ! filevault_on; then err "$(t ssd_fv_off_note)"; fi
      ;;
    hdd)
      info "$(t hdd_note)"
      ;;
    *)
      warn "$(t unknown_note)"
      if ! filevault_on; then err "$(t ssd_fv_off_note)"; fi
      ;;
  esac
  # Snapshots cut across disk type: even on an HDD with an honest overwrite, a copy in a
  # snapshot survives shred. That's why the warning comes after the disk verdict, not instead of it.
  _snapshot_note "$mp"
}

# Physical canonical path: strips trailing slashes, resolves .. and symlinks,
# INCLUDING the final component (if it is a directory or a symlink to one).
# This matters for the guard: `shred /tmp/s` where s→/System must see /System.
# Returns a non-empty string, or status !=0 if the path is inaccessible.
_abspath() {
  local p="$1"
  while [[ "$p" == */ && "$p" != "/" ]]; do p="${p%/}"; done
  if [[ -d "$p" ]]; then
    ( cd -P -- "$p" 2>/dev/null && pwd -P )
    return
  fi
  local d b
  d="$(cd -P -- "$(dirname -- "$p")" 2>/dev/null && pwd -P)" || return 1
  b="$(basename -- "$p")"
  printf '%s/%s' "${d%/}" "$b"
}

# Protected system path? We refuse to shred OS roots and system trees
# (the user's children like ~/file and user-temp are allowed). Guards against `shred /` etc.
# Comparison by canonicalized physical path + case-insensitive (APFS is
# case-insensitive by default) + prefix for system subtrees.
_is_protected_path() {
  local canon chome restore rc=1
  canon="$(_abspath "$1")" || return 1
  [[ -n "$canon" ]] || return 1
  # $HOME itself may contain symlink components (e.g. /var → /private/var).
  chome="$(cd -P -- "$HOME" 2>/dev/null && pwd -P)" || chome="$HOME"
  restore="$(shopt -p nocasematch)"
  shopt -s nocasematch
  case "$canon" in
    # OS roots and $HOME itself — checked FIRST, before the temp exception (otherwise a
    # $HOME living under /var/folders in tests would slip through as user-temp).
    / | "$HOME" | "$chome" \
      | /Users | /Volumes | /Applications | /Library | /System \
      | /usr | /bin | /sbin | /etc | /var | /private | /opt | /cores | /Network | /dev )
      rc=0 ;;
    # User temp trees are allowed explicitly (otherwise /private/var/* would swallow them).
    /private/var/folders/* | /private/tmp/* )
      rc=1 ;;
    # System subtrees — by prefix (after canonicalization /etc→/private/etc etc.).
    /System/* | /Library/* | /bin/* | /sbin/* \
      | /usr/bin/* | /usr/sbin/* | /usr/lib/* | /usr/libexec/* | /usr/share/* \
      | /private/etc | /private/etc/* | /private/var | /private/var/* )
      rc=0 ;;
  esac
  # Direct children of /Volumes (i.e. /Volumes/<name>) are mount-point roots, as
  # dangerous as /Volumes itself: shred would recursively wipe the whole volume or vault.
  # The /Volumes/* pattern in case also matches /Volumes/<name>/file — hence the separate check.
  if [[ "$canon" == /Volumes/* ]]; then
    local _vr="${canon#/Volumes/}"
    [[ -n "$_vr" && "$_vr" != */* ]] && rc=0
  fi
  eval "$restore"
  return "$rc"
}

# Permanently delete the given paths with an honest note on guarantees.
cmd_shred() {
  require_macos
  if [[ $# -eq 0 ]]; then err "$(t shred_need_path)"; exit 1; fi
  # Normalize trailing slashes: otherwise `rm -rfP -- symlink/` would descend into the
  # target while the guard checked the slashless path. Same path for the guard and for rm.
  local -a paths=()
  local p
  for p in "$@"; do
    while [[ "$p" == */ && "$p" != "/" ]]; do p="${p%/}"; done
    paths+=("$p")
  done
  for arg in "${paths[@]}"; do
    if _is_protected_path "$arg"; then err "$(t shred_protected "$arg")"; exit 1; fi
    if [[ ! -e "$arg" ]]; then err "$(t not_found "$arg")"; exit 1; fi
  done
  if ! confirm "$(t shred_confirm "${paths[*]}")"; then warn "$(t cancelled)"; exit 1; fi
  # Capture the mount point BEFORE deleting: after rm the path no longer exists and df
  # won't answer for it — the snapshot note would count the wrong volume (or nothing).
  local target_mp; target_mp="$(_mount_point "${paths[0]}")"
  for arg in "${paths[@]}"; do _shred_path "$arg"; info "$(t deleted "$arg")"; done
  # Judge the disk kind by the first target's volume, not always by /.
  _honest_disk_note "${paths[0]}" "$target_mp"
}

# Empty the trash folder while keeping the folder itself.
cmd_empty() {
  require_macos
  if [[ ! -d "$TRASH_DIR" ]]; then err "$(t empty_no_dir "$TRASH_DIR")"; exit 1; fi
  if [[ -z "$(ls -A "$TRASH_DIR")" ]]; then info "$(t empty_already)"; exit 0; fi
  if ! confirm "$(t empty_confirm "$TRASH_DIR")"; then warn "$(t cancelled)"; exit 1; fi
  # ${TRASH_DIR:?} guards against expanding to /* when the variable is empty.
  # -- guards against files whose names start with a dash.
  chmod -R u+w -- "${TRASH_DIR:?}"/* 2>/dev/null || true
  ( shopt -s dotglob nullglob; rm -rfP -- "${TRASH_DIR:?}"/* )
  info "$(t emptied "$TRASH_DIR")"
  _honest_disk_note "$TRASH_DIR"
}

# Read the container password: from ST_VAULT_PASS (tests/scripts) or interactively.
_vault_pass() {
  if [[ -n "${ST_VAULT_PASS:-}" ]]; then printf '%s' "$ST_VAULT_PASS"; return; fi
  read -r -s -p "$(t vault_pass)" p; echo >&2; printf '%s' "$p"
}

# Find the whole-disk dev-node (/dev/diskN) of the image bound to VAULT_PATH specifically.
# We parse `hdiutil info -plist` via PlistBuddy: more reliable than guessing by mount
# point (the volume name may collide into "SecretVault 1"). Empty if the
# image is not mounted or could not be determined — the caller falls back.
# Container state is **tri-state**, printing one of:
#   "mounted\t<dev>"  — image is mounted, dev-node known
#   "unmounted"       — image is definitely NOT mounted
#   "unknown"         — could not determine (hdiutil/mktemp/plist error)
# This is critical for destroy: on "unknown" we must not delete blindly (fail-closed),
# otherwise an undetermined state would be read as "not mounted" → rm.
_vault_state() {
  local plist tmp want path pc i dev target
  # Default path is the live container; reset also checks the set-aside .old,
  # otherwise a volume mounted from .old would go unnoticed before the crypto-shred.
  target="${1:-$VAULT_PATH}"
  want="$(_abspath "$target" 2>/dev/null || printf '%s' "$target")"
  plist="$(hdiutil info -plist 2>/dev/null)" || { echo unknown; return; }
  [[ -n "$plist" ]] || { echo unknown; return; }
  tmp="$(mktemp)" || { echo unknown; return; }
  trap 'rm -f "$tmp"' RETURN
  printf '%s' "$plist" > "$tmp"
  # Did not parse as a plist → state is unknown, not "empty".
  /usr/libexec/PlistBuddy -c 'Print :images' "$tmp" >/dev/null 2>&1 || { echo unknown; return; }
  i=0
  while path="$(/usr/libexec/PlistBuddy -c "Print :images:$i:image-path" "$tmp" 2>/dev/null)"; do
    # Compare both the raw and the canonicalized path (symlinks in $HOME).
    pc="$(_abspath "$path" 2>/dev/null || printf '%s' "$path")"
    if [[ "$path" == "$target" || "$pc" == "$want" ]]; then
      dev="$(/usr/libexec/PlistBuddy -c "Print :images:$i:system-entities:0:dev-entry" "$tmp" 2>/dev/null)" || dev=""
      if [[ -n "$dev" ]]; then printf 'mounted\t%s\n' "$dev"; return; fi
      echo unknown; return   # image found but without a dev-entry — odd → fail-closed
    fi
    i=$((i+1))
  done
  echo unmounted
}

# Thin wrapper: the mounted image's dev-node, or empty (for open/status,
# where fail-open is not destructive). For destroy we use _vault_state directly.
_vault_dev() {
  local s; s="$(_vault_state)"
  [[ "$s" == mounted$'\t'* ]] && printf '%s' "${s#mounted$'\t'}"
  return 0
}

# Unmount the container ONLY by our image's exact dev-node. No fallback to
# the mount point: a foreign/stale volume with the same name must not be detached.
# Return code: 0 — detach done; !=0 — image not recognized as mounted.
_vault_detach() {
  local dev; dev="$(_vault_dev)"
  if [[ -n "$dev" ]]; then
    hdiutil detach "$dev" 2>/dev/null
  else
    return 1
  fi
}

# Does it look like a valid sparsebundle container (not an arbitrary file/symlink)?
_is_sparsebundle() {
  [[ ! -L "$1" && -d "$1" && -e "$1/Info.plist" ]]
}

# Container size validation in hdiutil syntax (number + optional unit b/k/m/g/t).
# Critical for reset: without this a typo destroyed the old vault BEFORE create failed
# on the invalid size (AUDIT_2026-07-03 P2-2). Validate BEFORE destroy.
_assert_valid_size() {
  if ! [[ "$1" =~ ^[0-9]+[bkmgtBKMGT]?$ ]]; then err "$(t vault_bad_size "$1")"; exit 1; fi
  # Zero passes the regex, but `reset 0` would destroy the vault and fail on create (parity with ps1).
  if [[ "$1" =~ ^0+[bkmgtBKMGT]?$ ]]; then err "$(t vault_bad_size "$1")"; exit 1; fi
}

# --- shared low-level operations (reused by create/destroy/reset) ---
# Path of the "set-aside" old container. `${VAULT_PATH:?}` insures against an empty
# ST_VAULT_PATH, otherwise the path would degenerate into ".old" in the current directory.
_vault_aside_path() { printf '%s.old' "${VAULT_PATH:?}"; }

# Reset rollback: put the set-aside vault back in its regular place. Idempotent —
# ST_RESET_ASIDE is cleared, so a repeated invocation (INT → exit → EXIT) is a no-op.
ST_RESET_ASIDE=""
_vault_reset_rollback() {
  local rc=$? aside="${ST_RESET_ASIDE:-}"
  [[ -n "$aside" ]] || return $rc
  ST_RESET_ASIDE=""
  # The flag is armed BEFORE the mv, so the "set-aside" container may not exist yet —
  # then there is nothing to roll back and the vault sat in its regular place all along.
  [[ -e "$aside" ]] || return $rc
  rm -rf -- "$VAULT_PATH" 2>/dev/null || true   # the half-finished new container
  # If removing the half-finished container failed (locked band, AV, chflags uchg),
  # `mv` would put the old vault INSIDE it and return 0 — silent data loss
  # (the next destroy would raze the whole tree). The path must be free.
  if [[ ! -e "$VAULT_PATH" ]] && mv -- "$aside" "$VAULT_PATH" 2>/dev/null; then
    warn "$(t vault_reset_rolled_back "$VAULT_PATH")"
  else
    # Worst case: we could not put it back. We must name the exact path, otherwise
    # the user thinks the vault is gone while it sits nearby under a different name.
    err "$(t vault_restore_fail "$aside" "$VAULT_PATH")"
  fi
  return $rc
}

# Attempt to create the container. Returns hdiutil's exit code, does NOT exit the script:
# the caller (reset) must get the chance to roll back the set-aside old vault.
_vault_create_try() {
  local size="${1:-1g}"
  _vault_pass | hdiutil create -size "$size" -type SPARSEBUNDLE -fs APFS \
    -encryption AES-256 -stdinpass -volname SecretVault "$VAULT_PATH"
}

# Create the container. WITHOUT an existence check — the caller does it (create checks;
# reset calls this after the old container has been set aside).
_vault_create_now() {
  local size="${1:-1g}"
  # The path is free before the call (create checked it, reset moved the old one to .old). So
  # whatever appears at it when hdiutil fails is our half-finished container: it won't open,
  # but it occupies the vault's place, and the next create refuses with "vault already exists".
  # We remove only that.
  local existed=0; [[ -e "$VAULT_PATH" ]] && existed=1
  if ! _vault_create_try "$size"; then
    if (( ! existed )) && [[ -e "$VAULT_PATH" ]]; then rm -rf "${VAULT_PATH:?}"; fi
    err "$(t vault_create_fail "$VAULT_PATH")"
    exit 1
  fi
  info "$(t vault_created "$VAULT_PATH" "$size")"
  warn "$(t vault_preventive)"
}
# Destroyability validation: the container exists AND is a real sparsebundle (not a file).
# Checked BEFORE the confirm prompt, so we don't ask about a nonexistent/foreign path.
_vault_assert_destroyable() {
  if [[ ! -e "$VAULT_PATH" ]]; then err "$(t vault_no_container "$VAULT_PATH")"; exit 1; fi
  if ! _is_sparsebundle "$VAULT_PATH"; then err "$(t vault_bad_container "$VAULT_PATH")"; exit 1; fi
}
# Destruction mechanism WITHOUT confirm (the caller does it its own way: destroy and reset
# confirm with different wording). We delete the backing file ONLY when we reliably
# know the volume is not mounted: mounted → detach by exact dev-node; unknown →
# fail-closed (abort). Before rm we again require a reliable unmounted (covers
# detach-verify and nearly the whole TOCTOU race).
_vault_unmount_or_die() {
  local st dev
  st="$(_vault_state)"
  case "$st" in
    mounted*)
      dev="${st#mounted$'\t'}"
      hdiutil detach "$dev" 2>/dev/null || { err "$(t vault_destroy_busy)"; exit 1; }
      ;;
    unmounted) ;;
    *) err "$(t vault_destroy_busy)"; exit 1 ;;
  esac
  [[ "$(_vault_state)" == unmounted ]] || { err "$(t vault_destroy_busy)"; exit 1; }
}

_vault_destroy_now() {
  _vault_unmount_or_die
  rm -rfP -- "$VAULT_PATH"
  info "$(t vault_destroyed)"
}

# Encrypted container management: create|open|close|reset|destroy|status.
cmd_vault() {
  require_macos
  # A surviving .old is the trace of an interrupted reset. The user must learn WHERE
  # their data is, not guess: status would show "vault closed", but it's a different vault.
  if [[ -e "$VAULT_PATH.old" ]]; then warn "$(t vault_aside_notice "$VAULT_PATH.old")"; fi
  local sub="${1:-}"; shift || true
  case "$sub" in
    create)
      _assert_valid_size "${1:-1g}"
      if [[ -e "$VAULT_PATH" ]]; then err "$(t vault_exists "$VAULT_PATH")"; exit 1; fi
      _vault_create_now "${1:-1g}"
      ;;
    open)
      if [[ ! -e "$VAULT_PATH" ]]; then err "$(t vault_no_container_open)"; exit 1; fi
      # Already mounted (by exact dev-node)? Don't duplicate the attach.
      if [[ -n "$(_vault_dev)" ]]; then
        info "$(t vault_already_open "$VAULT_VOLUME")"; exit 0
      fi
      # -mountpoint pins the mount point (otherwise with /Volumes/SecretVault busy
      # macOS would mount as "SecretVault 1" and close/destroy/status would miss).
      # By default the volume is VISIBLE in Finder/sidebar and on the desktop: otherwise the
      # user, having closed the window, doesn't know where the vault is and easily forgets it
      # mounted — and an open vault "at risk" is a bigger risk than the visibility itself.
      # Visibility also gives the standard way out: "Eject" from Finder unmounts the volume
      # automatically. To hide it (old behavior, -nobrowse — off the sidebar/desktop): ST_VAULT_HIDDEN=1.
      local attach_opts
      attach_opts=( -mountpoint "$VAULT_VOLUME" )
      if [[ "${ST_VAULT_HIDDEN:-0}" == "1" ]]; then attach_opts+=( -nobrowse ); fi
      _vault_pass | hdiutil attach "$VAULT_PATH" -stdinpass "${attach_opts[@]}"
      info "$(t vault_mounted "$VAULT_VOLUME")"
      # Integration point: vaultwatch starts from here, receiving the mount point.
      _run_vault_hook post-open "$VAULT_VOLUME"
      # Pop the volume window right away so the user sees where to put files (like on a
      # double-click of a dmg). Also useful with ST_VAULT_HIDDEN=1, when the volume isn't in the sidebar.
      # Disable: ST_VAULT_NO_REVEAL=1.
      if [[ "${ST_VAULT_NO_REVEAL:-0}" != "1" ]] && command -v open >/dev/null 2>&1; then
        open "$VAULT_VOLUME" >/dev/null 2>&1 || true
      fi
      ;;
    close)
      _vault_detach || { err "$(t vault_detach_fail)"; exit 1; }
      info "$(t vault_closed)"
      # Integration point: vaultwatch shuts down from here, restoring the exclusions.
      _run_vault_hook post-close "$VAULT_VOLUME"
      ;;
    status)
      if [[ ! -e "$VAULT_PATH" ]]; then err "$(t vault_no_container "$VAULT_PATH")"; exit 1; fi
      if [[ -n "$(_vault_dev)" ]]; then
        info "$(t vault_status_open "$VAULT_VOLUME")"
      else
        info "$(t vault_status_closed "$VAULT_PATH")"
      fi
      ;;
    destroy)
      _vault_assert_destroyable
      if ! confirm "$(t vault_destroy_confirm "$VAULT_PATH")"; then warn "$(t cancelled)"; exit 1; fi
      _vault_destroy_now
      ;;
    reset)
      # "Clear the vault, keep the vault itself" with a REAL guarantee: in-place overwrite on
      # SSD is best-effort (the same key keeps decrypting the residual band blocks).
      # The only honest way is a crypto-shred of the container (throw away the key) + create
      # a new empty one (new key → the old is dead forever). One confirm for the whole operation.
      local reset_size="${1:-1g}"
      _assert_valid_size "$reset_size"   # BEFORE destroy: an invalid size must not doom the vault
      _vault_assert_destroyable
      # A surviving .old is the user's DATA (an interrupted reset or their manual
      # backup). It must not be razed silently. The refusal comes BEFORE confirm: no point
      # asking "destroy everything?" only to say "no" right after.
      if [[ -e "$(_vault_aside_path)" ]]; then err "$(t vault_aside_exists "$(_vault_aside_path)")"; exit 1; fi
      if ! confirm "$(t vault_reset_confirm "$VAULT_PATH")"; then warn "$(t cancelled)"; exit 1; fi
      # There must be no window between "the old vault is gone" and "the new one is ready":
      # destroy used to go first, and a create failure (no space, hdiutil refusal, Ctrl-C at
      # the password prompt) left the user with no vault at all. Now the old
      # container is set aside to .old, the new one is created in its place, and only after
      # success is the old one crypto-shredded. The rollback hangs on a trap, not just on the
      # error branch: Ctrl-C arrives exactly at the password prompt, already AFTER the move.
      local aside; aside="$(_vault_aside_path)"
      _vault_unmount_or_die       # only a detached volume may be renamed
      # Armed BEFORE the mv: a signal arriving between the move and installing the trap
      # would otherwise leave the vault in .old with no rollback. Rollback itself checks what to move.
      ST_RESET_ASIDE="$aside"
      trap '_vault_reset_rollback' EXIT
      trap '_vault_reset_rollback; exit 130' INT TERM HUP QUIT
      mv -- "$VAULT_PATH" "$aside" || { err "$(t vault_create_fail "$VAULT_PATH")"; exit 1; }
      if ! _vault_create_try "$reset_size"; then
        err "$(t vault_create_fail "$VAULT_PATH")"
        exit 1                    # the EXIT trap will do the rollback
      fi
      ST_RESET_ASIDE=""           # the new vault is in place — nothing left to roll back
      trap - EXIT INT TERM HUP QUIT
      # While create was running, the user may have mounted a volume from .old (Finder sees the file).
      # Shredding blindly is forbidden — it would raze the backing store of a live decrypted volume.
      if [[ "$(_vault_state "$aside")" != unmounted ]]; then
        err "$(t vault_aside_busy "$aside")"; exit 1
      fi
      if ! rm -rfP -- "$aside"; then
        # The new vault is already created, but the old one is NOT destroyed: silence is not
        # an option — the crypto-shred promise is unfulfilled, a decryptable copy sits nearby.
        err "$(t vault_aside_left "$aside")"; exit 1
      fi
      info "$(t vault_destroyed)"
      info "$(t vault_created "$VAULT_PATH" "$reset_size")"
      warn "$(t vault_preventive)"
      info "$(t vault_reset_done)"
      ;;
    destroy-old)
      # The only official way to remove a container set aside by an interrupted reset.
      # A separate command, not part of destroy: destroy hits the active vault, and
      # mixing two different targets in one confirmation is a straight road to a miss.
      local old_path; old_path="$(_vault_aside_path)"
      if [[ ! -e "$old_path" ]]; then err "$(t vault_old_none "$old_path")"; exit 1; fi
      if ! _is_sparsebundle "$old_path"; then err "$(t vault_bad_container "$old_path")"; exit 1; fi
      # Early check — so we don't ask about a volume that is known to be busy.
      if [[ "$(_vault_state "$old_path")" != unmounted ]]; then
        err "$(t vault_aside_busy "$old_path")"; exit 1
      fi
      if ! confirm "$(t vault_old_confirm "$old_path")"; then warn "$(t cancelled)"; exit 1; fi
      # And AGAIN before rm: confirm waits for input indefinitely, and we ourselves advise
      # "hdiutil attach, take your data" — the user may well mount .old
      # right while the prompt hangs. The backing store of a live volume must not be razed.
      if [[ "$(_vault_state "$old_path")" != unmounted ]]; then
        err "$(t vault_aside_busy "$old_path")"; exit 1
      fi
      rm -rfP -- "$old_path"
      info "$(t vault_old_destroyed "$old_path")"
      ;;
    *)
      err "$(t vault_usage)"; exit 1 ;;
  esac
}

main() {
  # --yes anywhere in the arguments == ST_ASSUME_YES=1. The flag is cut from the list,
  # the remaining arguments keep their original order.
  local args=()
  local a
  for a in "$@"; do
    if [[ "$a" == "--yes" ]]; then
      ST_ASSUME_YES=1
    else
      args+=("$a")
    fi
  done
  set -- "${args[@]:-}"
  # If no arguments remain after the cut, ${args[@]:-} yields a single empty
  # string — normalize to a true "no arguments".
  if [[ $# -eq 1 && -z "${1:-}" ]]; then set --; fi

  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then usage; exit 1; fi
  shift || true
  case "$cmd" in
    version|-v|--version) cmd_version "$@" ;;
    help|-h|--help)  usage ;;
    check) cmd_check "$@" ;;
    setup) cmd_setup "$@" ;;
    shred) cmd_shred "$@" ;;
    empty) cmd_empty "$@" ;;
    vault) cmd_vault "$@" ;;
    *) t unknown_cmd "$cmd" >&2; echo >&2; usage >&2; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
