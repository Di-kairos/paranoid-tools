# === Shamir Secret Sharing over GF(256) ===
# The field GF(2^8), reducing polynomial 0x11b (as in AES). Addition = XOR.
# Multiplication — via log/antilog tables of the generator 0x03 (a primitive element of the field).
# Division/inversion — via the same tables. All operations act on the bytes of the secret.
# LIMIT (honestly, see README "Scope & limitations"): multiplication via log/antilog tables
# is NOT constant-time — there is a timing side-channel. Outside the threat model of a local
# CLI (no remote/online oracle on split/combine), but we do not hide it.

# sha256 → hex (portable: macOS shasum / Linux sha256sum). For checksums.
_sha256_hex() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -d' ' -f1
  else sha256sum | cut -d' ' -f1; fi
}
# bytes(stdin) → hex without spaces; hex(arg) → raw bytes(stdout). No xxd (missing on some systems).
_to_hex() { od -An -v -tx1 | tr -d ' \n'; }
_from_hex() { local h="$1" i; for ((i=0; i<${#h}; i+=2)); do printf '%b' "\\x${h:i:2}"; done; }

# GF(256) tables: GF_EXP[i]=g^i (g=3), GF_LOG[v]=i. Generated once.
_gf_init() {
  local x=1 i tt
  GF_EXP=(); GF_LOG=()
  for ((i=0; i<255; i++)); do
    GF_EXP[i]=$x
    GF_LOG[x]=$i
    tt=$(( (x<<1) & 0xff ))                 # xtime(x) = x*2 in GF
    if (( x & 0x80 )); then tt=$(( tt ^ 0x1b )); fi
    x=$(( tt ^ x ))                          # x*3 = xtime(x) XOR x
  done
}

# === Reed-Solomon: correcting typos in a share copied back from paper (SSS3 format) ===
# Why: shares live on paper, and paper is transcribed by hand. Before SSS3 a single wrong
# character killed the whole share — chk4 honestly said "corrupted", but there was nothing
# to repair it with.
# RS(k+4, k) over the SAME GF(256): 4 parity bytes per chunk of ≤251 payload bytes,
# corrects up to TWO wrong bytes per chunk (two typos in different bytes; two typos
# within one byte also count as one error). A typo in the structural part of the share
# (setid/T/x) is NOT corrected — chk4 catches it; the README says exactly that, without
# pretending RS fixes everything.
# The decoder is Peterson for t<=2 + root search: on four syndromes it does exactly what
# Berlekamp-Massey does, in a third of the code. Any correction failure = honest refusal:
# the 128-bit payload tag remains the last line of defense against "silently the wrong secret".
RS_PARITY=4          # parity bytes per chunk
RS_CHUNK=251         # maximum message bytes per chunk (251 + 4 <= 255)

# GF(256) multiplication without a subshell: result in RES (a fork per multiplication would eat everything).
_gf_mul() {
  if (( $1 == 0 || $2 == 0 )); then RES=0
  else RES=${GF_EXP[$(( (GF_LOG[$1]+GF_LOG[$2]) % 255 ))]}; fi
}
# Multiplicative inverse: inv(a) = g^(255 - log a).
_gf_inv() {
  if (( $1 == 0 )); then RES=0
  else RES=${GF_EXP[$(( (255 - GF_LOG[$1]) % 255 ))]}; fi
}

# Generator polynomial g(x) = (x+a^0)(x+a^1)(x+a^2)(x+a^3) in descending order, RS_G[0]=1.
_rs_gen_init() {
  local i j d
  RS_G=(1)
  for ((i=0; i<RS_PARITY; i++)); do
    local ai=${GF_EXP[i]}
    d=${#RS_G[@]}
    local -a NG=()
    for ((j=0; j<=d; j++)); do NG[j]=0; done
    for ((j=0; j<d; j++)); do
      NG[j]=$(( NG[j] ^ RS_G[j] ))                       # high shift: multiplication by x
      _gf_mul "${RS_G[j]}" "$ai"; NG[j+1]=$(( NG[j+1] ^ RES ))
    done
    RS_G=("${NG[@]}")
  done
}

# Parity for the message in RS_MSG[] (bytes, most significant first) → RS_PAR[] of RS_PARITY bytes.
# Ordinary polynomial division: the remainder of msg*x^4 modulo g. Arrays are passed via
# globals, not namerefs: `local -n` requires bash 4.3, and the system bash on macOS is 3.2.
_rs_encode() {
  local k=${#RS_MSG[@]} i j
  local -a W=()
  for ((i=0; i<k; i++)); do W[i]=${RS_MSG[i]}; done
  for ((i=0; i<RS_PARITY; i++)); do W[k+i]=0; done
  for ((i=0; i<k; i++)); do
    local coef=${W[i]}
    (( coef == 0 )) && continue
    for ((j=1; j<=RS_PARITY; j++)); do
      _gf_mul "${RS_G[j]}" "$coef"; W[i+j]=$(( W[i+j] ^ RES ))
    done
  done
  RS_PAR=()
  for ((i=0; i<RS_PARITY; i++)); do RS_PAR[i]=${W[k+i]}; done
}

# Syndromes of the codeword RS_CW[] (message + parity): S_i = CW(a^i), i=0..RS_PARITY-1.
# All zeros → no errors.
_rs_syndromes() {
  local n=${#RS_CW[@]} i p
  RS_SYN=()
  for ((i=0; i<RS_PARITY; i++)); do
    local xi=${GF_EXP[i]} acc=0
    for ((p=0; p<n; p++)); do
      _gf_mul "$acc" "$xi"; acc=$(( RES ^ RS_CW[p] ))    # Horner's scheme
    done
    RS_SYN[i]=$acc
  done
}

# Correct up to two byte errors in the codeword (fixed in place).
# RS_FIXED = number of corrected bytes. Return code: 0 — the word is clean or was repaired
# and the syndromes zeroed out; 1 — uncorrectable (fail-closed, we never silently return a wrong word).
_rs_correct() {
  local n=${#RS_CW[@]} i p
  _rs_syndromes
  RS_FIXED=0
  local s0=${RS_SYN[0]} s1=${RS_SYN[1]} s2=${RS_SYN[2]} s3=${RS_SYN[3]}
  (( s0 == 0 && s1 == 0 && s2 == 0 && s3 == 0 )) && return 0

  # --- one error: e = S0, X = S1/S0; verified against S2 and S3 ---
  if (( s0 != 0 )); then
    _gf_inv "$s0"; local inv0=$RES
    _gf_mul "$s1" "$inv0"; local X=$RES
    local e=$s0 ok=1 chk
    _gf_mul "$e" "$X"; (( RES == s1 )) || ok=0
    _gf_mul "$X" "$X"; chk=$RES; _gf_mul "$e" "$chk"; (( RES == s2 )) || ok=0
    _gf_mul "$chk" "$X"; chk=$RES; _gf_mul "$e" "$chk"; (( RES == s3 )) || ok=0
    if (( ok )); then
      # X = a^(n-1-p) → position p = n-1-log(X)
      (( X != 0 )) || return 1
      p=$(( n - 1 - GF_LOG[X] ))
      (( p >= 0 && p < n )) || return 1
      RS_CW[p]=$(( RS_CW[p] ^ e ))
      RS_FIXED=1
      _rs_syndromes
      (( RS_SYN[0] == 0 && RS_SYN[1] == 0 && RS_SYN[2] == 0 && RS_SYN[3] == 0 )) || return 1
      return 0
    fi
  fi

  # --- two errors (Peterson): l1*S1 + l2*S0 = S2 ; l1*S2 + l2*S1 = S3 ---
  local d a b
  _gf_mul "$s1" "$s1"; d=$RES; _gf_mul "$s0" "$s2"; d=$(( d ^ RES ))
  (( d != 0 )) || return 1
  _gf_inv "$d"; local invd=$RES
  _gf_mul "$s2" "$s1"; a=$RES; _gf_mul "$s0" "$s3"; a=$(( a ^ RES ))
  _gf_mul "$a" "$invd"; local l1=$RES
  _gf_mul "$s1" "$s3"; b=$RES; _gf_mul "$s2" "$s2"; b=$(( b ^ RES ))
  _gf_mul "$b" "$invd"; local l2=$RES

  # Roots of L(z) = 1 + l1*z + l2*z^2, where z = X^-1. We iterate over positions — n <= 255.
  local -a POS=() XV=()
  for ((p=0; p<n; p++)); do
    local Xp=${GF_EXP[$(( (n - 1 - p) % 255 ))]} z v t2
    _gf_inv "$Xp"; z=$RES
    _gf_mul "$l1" "$z"; v=$(( 1 ^ RES ))
    _gf_mul "$z" "$z"; t2=$RES; _gf_mul "$l2" "$t2"; v=$(( v ^ RES ))
    if (( v == 0 )); then POS+=("$p"); XV+=("$Xp"); fi
  done
  (( ${#POS[@]} == 2 )) || return 1

  # Error magnitudes: e1 + e2 = S0 ; e1*X1 + e2*X2 = S1.
  local X1=${XV[0]} X2=${XV[1]} den e1 e2
  den=$(( X1 ^ X2 )); (( den != 0 )) || return 1
  _gf_inv "$den"; local invden=$RES
  _gf_mul "$s0" "$X2"; e1=$(( s1 ^ RES )); _gf_mul "$e1" "$invden"; e1=$RES
  e2=$(( s0 ^ e1 ))
  (( e1 != 0 && e2 != 0 )) || return 1
  local p0=${POS[0]} p1=${POS[1]}
  RS_CW[p0]=$(( RS_CW[p0] ^ e1 ))
  RS_CW[p1]=$(( RS_CW[p1] ^ e2 ))
  RS_FIXED=2
  _rs_syndromes
  (( RS_SYN[0] == 0 && RS_SYN[1] == 0 && RS_SYN[2] == 0 && RS_SYN[3] == 0 )) || return 1
  return 0
}

# payload hex → parity hex (in chunks of RS_CHUNK bytes; for real seeds it's a single chunk).
_rs_parity_hex() {
  local hex="$1" total=$(( ${#1} / 2 )) off=0 out="" i hb
  _gf_init; _rs_gen_init
  while (( off < total )); do
    local take=$(( total - off )); (( take > RS_CHUNK )) && take=$RS_CHUNK
    RS_MSG=()
    for ((i=0; i<take; i++)); do RS_MSG[i]=$(( 16#${hex:(off+i)*2:2} )); done
    _rs_encode
    for ((i=0; i<RS_PARITY; i++)); do printf -v hb '%02x' "${RS_PAR[i]}"; out+="$hb"; done
    off=$(( off + take ))
  done
  printf '%s' "$out"
}

# payload hex + parity hex → corrected RS_OUT_HEX and RS_OUT_PAR_HEX, number of fixes in
# RS_FIXED_TOTAL. Return code 1 — the decoder did not converge.
# IMPORTANT: parity is returned too — a typo could have landed in it, in which case it is the
# parity that must be corrected, not the body (otherwise chk4 would compare against the still
# corrupted par and the repair would never count).
_rs_repair_hex() {
  local hex="$1" par="$2" total=$(( ${#1} / 2 )) off=0 ci=0 i hb
  _gf_init; _rs_gen_init
  RS_OUT_HEX=""; RS_OUT_PAR_HEX=""; RS_FIXED_TOTAL=0
  local want_par=$(( ( (total + RS_CHUNK - 1) / RS_CHUNK ) * RS_PARITY ))
  (( ${#par} == want_par * 2 )) || return 1
  while (( off < total )); do
    local take=$(( total - off )); (( take > RS_CHUNK )) && take=$RS_CHUNK
    RS_CW=()
    for ((i=0; i<take; i++)); do RS_CW[i]=$(( 16#${hex:(off+i)*2:2} )); done
    for ((i=0; i<RS_PARITY; i++)); do RS_CW[take+i]=$(( 16#${par:(ci*RS_PARITY+i)*2:2} )); done
    _rs_correct || return 1
    RS_FIXED_TOTAL=$(( RS_FIXED_TOTAL + RS_FIXED ))
    for ((i=0; i<take; i++)); do printf -v hb '%02x' "${RS_CW[i]}"; RS_OUT_HEX+="$hb"; done
    for ((i=0; i<RS_PARITY; i++)); do printf -v hb '%02x' "${RS_CW[take+i]}"; RS_OUT_PAR_HEX+="$hb"; done
    off=$(( off + take )); ci=$(( ci + 1 ))
  done
  return 0
}

# === passphrase layer (opt-in) ===
# Encrypts the secret BEFORE splitting via native openssl (AES-256-CBC + PBKDF2). This way a
# reconstructed threshold of shares yields only a standard `Salted__` container — the secret is
# still behind the passphrase. The split/combine core is untouched (it cuts/assembles arbitrary
# bytes). openssl is needed ONLY for this mode — the core stays zero-dep. Parameters are fixed →
# decryption is compatible anywhere openssl exists.
PP_ITER=200000

# Read the passphrase for encryption (with confirmation). Env SEEDSPLIT_PASSPHRASE — for tests/
# automation; otherwise hidden input from /dev/tty (stdin is occupied by the secret in a pipe).
# Prints the passphrase to stdout.
_pp_read_set() {
  if [[ -n "${SEEDSPLIT_PASSPHRASE:-}" ]]; then printf '%s' "$SEEDSPLIT_PASSPHRASE"; return 0; fi
  local p1 p2
  printf '%s' "$(t pp_set)" >/dev/tty; read -rs p1 </dev/tty; echo >/dev/tty
  printf '%s' "$(t pp_confirm)" >/dev/tty; read -rs p2 </dev/tty; echo >/dev/tty
  [[ -n "$p1" ]] || { p1=""; p2=""; err "$(t pp_empty)"; return 1; }
  [[ "$p1" == "$p2" ]] || { p1=""; p2=""; err "$(t pp_mismatch)"; return 1; }
  p2=""
  printf '%s' "$p1"
}

# Read the passphrase for decryption (single input). Env override same as _pp_read_set.
_pp_read_unlock() {
  if [[ -n "${SEEDSPLIT_PASSPHRASE:-}" ]]; then printf '%s' "$SEEDSPLIT_PASSPHRASE"; return 0; fi
  local p
  printf '%s' "$(t pp_locked)" >/dev/tty; read -rs p </dev/tty; echo >/dev/tty
  printf '%s' "$p"
}

# Encrypt secret_hex with the passphrase → ct_hex. Passphrase via fd:3 (NOT argv → not visible in `ps`).
_pp_encrypt_hex() {
  local sec_hex="$1" pp="$2" ct_hex
  # Passphrase via fd:3 from a process substitution (a pipe, NOT the on-disk here-string `<<<`,
  # which would materialize the passphrase into a temporary file in $TMPDIR → carving/leak). See P1-5.
  ct_hex="$(_from_hex "$sec_hex" | openssl enc -aes-256-cbc -pbkdf2 -iter "$PP_ITER" -salt -pass fd:3 3< <(printf '%s' "$pp") 2>/dev/null | _to_hex)" || return 1
  [[ -n "$ct_hex" ]] || return 1
  printf '%s' "$ct_hex"
}

cmd_split() {
  local n=3 t=2 file="" use_pp=0
  while (( $# )); do
    case "$1" in
      -n|--shares)        n="${2:?}"; shift 2 ;;
      -t|--threshold)     t="${2:?}"; shift 2 ;;
      --file)             file="${2:?}"; shift 2 ;;
      -p|--passphrase)    use_pp=1; shift ;;
      *) err "$(t split_bad_arg "$1")"; exit 1 ;;
    esac
  done

  # The secret comes from stdin or --file, as hex. Never from argv (visible in `ps`).
  local secret_hex
  if [[ -n "$file" ]]; then
    [[ -r "$file" ]] || { err "$(t split_file_unreadable "$file")"; exit 1; }
    secret_hex="$(_to_hex < "$file")"
  elif [[ -t 0 ]]; then
    # Interactive run: without a prompt the command just sat silent waiting for stdin — that
    # read as a hang, and the typed secret stayed in the scrollback. We read from /dev/tty
    # without echo, as one line (a seed phrase is single-line). The newline does NOT go into
    # the secret.
    # IFS= is mandatory: with the default IFS bash would trim leading/trailing spaces, and the
    # same secret via TTY and via a pipe would yield DIFFERENT shares. `|| true` — EOF (Ctrl-D)
    # returns a non-zero code even after partial input: under set -e that would kill both the
    # entered bytes and the honest empty-secret error below.
    local line=""
    printf '%s' "$(t split_prompt)" >/dev/tty
    IFS= read -rs line </dev/tty || true
    echo >/dev/tty
    secret_hex="$(printf '%s' "$line" | _to_hex)"
    line=""
  else
    secret_hex="$(_to_hex)"
  fi
  [[ -n "$secret_hex" ]] || { err "$(t split_empty_secret)"; exit 1; }

  # Passphrase layer (opt-in): encrypt the secret BEFORE splitting. Shares = Shamir over the ciphertext.
  if (( use_pp )); then
    command -v openssl >/dev/null 2>&1 || { err "$(t pp_no_openssl)"; exit 1; }
    local pp; pp="$(_pp_read_set)" || exit 1
    secret_hex="$(_pp_encrypt_hex "$secret_hex" "$pp")" || { pp=""; err "$(t pp_enc_fail)"; exit 1; }
    pp=""   # scrub from memory
  fi

  [[ "$n" =~ ^[0-9]+$ && "$t" =~ ^[0-9]+$ ]] || { err "$(t split_nt_not_num)"; exit 1; }
  (( t >= 2 )) || { err "$(t split_t_min)"; exit 1; }
  (( n >= t )) || { err "$(t split_n_lt_t "$n" "$t")"; exit 1; }
  (( n <= 255 )) || { err "$(t split_n_max)"; exit 1; }

  local L=$(( ${#secret_hex} / 2 ))
  (( L <= 65535 )) || { err "$(t split_secret_big)"; exit 1; }

  # Random set-id (4-byte nonce) — NOT derived from the secret (otherwise a confirmation
  # oracle: with one share + a candidate secret one could test the guess without collecting
  # the threshold). Identical across all shares of a set → combine DETERMINISTICALLY rejects
  # mixing shares from different splits (rather than probabilistically).
  local setid_hex
  setid_hex="$(head -c 4 /dev/urandom | _to_hex)"
  [[ ${#setid_hex} -eq 8 ]] || { err "$(t split_low_entropy)"; exit 1; }

  # Integrity wrapper: 0x55 | len(2B BE) | secret | tag(16B = first 16 bytes of sha256 of the preceding).
  # 128-bit tag: combine returns EITHER the exact secret OR an honest refusal; the chance of
  # silently handing back the WRONG secret ≈ 2^-128 (versus 2^-16 with the old 2-byte CRC).
  local hi=$(( L >> 8 )) lo=$(( L & 0xff )) core_hex tag_hex
  printf -v core_hex '55%02x%02x%s' "$hi" "$lo" "$secret_hex"
  tag_hex="$(_from_hex "$core_hex" | _sha256_hex)"; tag_hex="${tag_hex:0:32}"
  local payload_hex="${core_hex}${tag_hex}" PL
  PL=$(( ${#payload_hex} / 2 ))

  local -a P=(); local k
  for ((k=0; k<PL; k++)); do P[k]=$(( 16#${payload_hex:k*2:2} )); done

  _gf_init

  # (t-1) random bytes per payload byte — the higher coefficients of the polynomials.
  local need=$(( (t-1) * PL )) rand_hex
  rand_hex="$(head -c "$need" /dev/urandom | _to_hex)"
  [[ ${#rand_hex} -eq $((need*2)) ]] || { err "$(t split_low_entropy)"; exit 1; }

  local -a Y=(); local x j ri=0 y hb
  for ((x=1; x<=n; x++)); do Y[x]=""; done
  for ((k=0; k<PL; k++)); do
    # Polynomial for byte k: c0=P[k] (the secret), c1..c_{t-1} = random. Evaluated at x=1..n (Horner).
    local -a C=(); C[0]=${P[k]}
    for ((j=1; j<t; j++)); do C[j]=$(( 16#${rand_hex:ri*2:2} )); ri=$((ri+1)); done
    for ((x=1; x<=n; x++)); do
      y=${C[t-1]}
      for ((j=t-2; j>=0; j--)); do
        if (( y != 0 )); then y=${GF_EXP[$(( (GF_LOG[y]+GF_LOG[x]) % 255 ))]}; fi
        y=$(( y ^ C[j] ))
      done
      printf -v hb '%02x' "$y"; Y[x]+="$hb"
    done
  done

  # Share: SSS3-<setid>-<T>-<x>-<hexY>-<par>-<chk4>.
  #   par  — RS parity over the bytes of hexY: repairs up to 2 typos in the longest part of the share;
  #   chk4 — a quick "is this line intact at all" check (including setid/T/x, which RS does not cover);
  #   setid — deterministic refusal when shares from different splits are mixed.
  # SSS2 (no parity) remains readable for combine — old printouts do not turn into garbage.
  local -a SHARES=(); local chk body par
  for ((x=1; x<=n; x++)); do
    par="$(_rs_parity_hex "${Y[x]}")"
    body="SSS3-${setid_hex}-${t}-${x}-${Y[x]}-${par}"
    chk="$(printf '%s' "$body" | _sha256_hex)"; chk="${chk:0:4}"
    SHARES+=("${body}-${chk}")
  done

  # Round-trip self-check BEFORE printing: reconstruct the secret by exactly the same path as
  # `combine` from the first T shares and compare against the original. Catches any breakage of
  # generation/GF math EARLIER than the user hands out shares and wipes the original seed
  # (otherwise a loss with no reassembly guarantee). Transiently materializes T shares (as a
  # normal combine does) — the shares go to stdout anyway, this is not a secret leak.
  local sc_in sc_out
  sc_in="$(printf '%s\n' "${SHARES[@]:0:t}")"
  sc_out="$(_recover_secret_hex "$sc_in" 2>/dev/null)"
  if [[ "$sc_out" != "$secret_hex" ]]; then
    err "$(t split_selfcheck_fail)"; exit 1
  fi

  printf '%s\n' "${SHARES[@]}"
}

# Reconstructing the secret from shares: parsing + ALL checks + Lagrange interpolation at zero.
# Prints secret_hex to stdout on success; on ANY error — a message to stderr and `return !=0`
# (NOT exit: the function is called inside $(...), exit would kill only the subshell and leave
# the caller without a status check). The error taxonomy distinguishes: non-SSS2 / share
# corruption (CRC) / different splits (set-id) / diverging threshold T / below threshold /
# payload integrity failure.
_recover_secret_hex() {
  local raw="$1"
  RS_NOTICES=()
  _gf_init
  local -a XS=() YS=()
  local line ylen="" t_decl="" setid_seen="" cnt=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local sid T x yh chk par="" fmt
    if [[ "$line" =~ ^SSS3-([0-9a-f]{8})-([0-9]+)-([0-9]+)-([0-9a-f]+)-([0-9a-f]+)-([0-9a-f]{4})$ ]]; then
      fmt=SSS3
      sid="${BASH_REMATCH[1]}"; T="${BASH_REMATCH[2]}"; x="${BASH_REMATCH[3]}"
      yh="${BASH_REMATCH[4]}"; par="${BASH_REMATCH[5]}"; chk="${BASH_REMATCH[6]}"
    elif [[ "$line" =~ ^SSS2-([0-9a-f]{8})-([0-9]+)-([0-9]+)-([0-9a-f]+)-([0-9a-f]{4})$ ]]; then
      fmt=SSS2
      sid="${BASH_REMATCH[1]}"; T="${BASH_REMATCH[2]}"; x="${BASH_REMATCH[3]}"
      yh="${BASH_REMATCH[4]}"; chk="${BASH_REMATCH[5]}"
    else
      err "$(t combine_not_sss2 "$line")"; return 1
    fi
    local body want
    if [[ "$fmt" == SSS3 ]]; then
      # The parity length must match the number of chunks: otherwise the share looks intact
      # but there is nothing to repair it with — and you want to learn that immediately,
      # not at the moment of a typo.
      local chunks=$(( ( (${#yh} / 2) + RS_CHUNK - 1 ) / RS_CHUNK ))
      (( ${#par} == chunks * RS_PARITY * 2 )) || { err "$(t combine_bad_parity "$x")"; return 1; }
      body="SSS3-${sid}-${T}-${x}-${yh}-${par}"
    else body="SSS2-${sid}-${T}-${x}-${yh}"; fi
    want="$(printf '%s' "$body" | _sha256_hex)"; want="${want:0:4}"
    if [[ "$chk" != "$want" ]]; then
      # The checksum did not match. SSS3 has parity — try to repair the longest (and most
      # typo-prone) part of the share. We repair ONLY if chk4 matches after the fix:
      # RS does not cover setid/T/x, and a wrong x would yield a wrong reconstruction.
      local repaired=0
      if [[ "$fmt" == SSS3 ]] && _rs_repair_hex "$yh" "$par" && (( RS_FIXED_TOTAL > 0 )); then
        local try_body="SSS3-${sid}-${T}-${x}-${RS_OUT_HEX}-${RS_OUT_PAR_HEX}" try_want
        try_want="$(printf '%s' "$try_body" | _sha256_hex)"; try_want="${try_want:0:4}"
        if [[ "$chk" == "$try_want" ]]; then
          yh="$RS_OUT_HEX"; par="$RS_OUT_PAR_HEX"; repaired=1
          # We accumulate the message rather than printing right away: saying "repaired" only
          # makes sense after the 128-bit payload tag has matched. Otherwise the user would
          # read "repaired" for a set that is honestly rejected right afterwards.
          RS_NOTICES+=("$(t combine_repaired "$x" "$RS_FIXED_TOTAL")")
        fi
      fi
      if (( ! repaired )); then
        if [[ "$fmt" == SSS3 ]]; then err "$(t combine_unrepairable "$x")"; else err "$(t combine_corrupt "$x")"; fi
        return 1
      fi
    fi
    (( x >= 1 && x <= 255 )) || { err "$(t combine_bad_x "$x")"; return 1; }
    # set-id: all shares of a set must match (deterministic refusal when splits are mixed).
    if [[ -z "$setid_seen" ]]; then setid_seen="$sid"
    elif [[ "$sid" != "$setid_seen" ]]; then
      err "$(t combine_diff_splits "$sid" "$setid_seen")"; return 1
    fi
    # declared-T: all shares must declare the same threshold.
    if [[ -z "$t_decl" ]]; then t_decl="$T"
    elif [[ "$T" != "$t_decl" ]]; then
      err "$(t combine_diff_t "$T" "$t_decl")"; return 1
    fi
    local d; for d in "${XS[@]:-}"; do [[ "$d" == "$x" ]] && { err "$(t combine_dup "$x")"; return 1; }; done
    [[ -z "$ylen" ]] && ylen="${#yh}"
    [[ "${#yh}" -eq "$ylen" ]] || { err "$(t combine_diff_len)"; return 1; }
    XS+=("$x"); YS+=("$yh"); cnt=$((cnt+1))
  done <<< "$raw"

  (( cnt >= 1 )) || { err "$(t combine_no_shares)"; return 1; }
  if [[ -n "$t_decl" ]] && (( cnt < t_decl )); then
    err "$(t combine_below "$t_decl" "$cnt")"; return 1
  fi

  # Lagrange weights at zero (identical for all bytes): w_i = prod_{j!=i} x_j * inv(x_i XOR x_j).
  local m=$cnt i j
  local -a W=()
  for ((i=0; i<m; i++)); do
    local num=1 xi="${XS[i]}"
    for ((j=0; j<m; j++)); do
      (( j == i )) && continue
      local xj="${XS[j]}"; local den=$(( xi ^ xj ))
      (( den != 0 )) || { err "$(t combine_coincident)"; return 1; }
      num=${GF_EXP[$(( (GF_LOG[num]+GF_LOG[xj]) % 255 ))]}                 # num *= x_j
      num=${GF_EXP[$(( (GF_LOG[num]+(255-GF_LOG[den])%255) % 255 ))]}      # num *= inv(den)
    done
    W[i]=$num
  done

  # Reconstruction of each payload byte: acc = XOR_i ( y_i[p] * w_i ).
  local PL=$(( ylen / 2 )) p payload_hex="" acc yb term hb
  for ((p=0; p<PL; p++)); do
    acc=0
    for ((i=0; i<m; i++)); do
      yb=$(( 16#${YS[i]:p*2:2} ))
      if (( yb != 0 )); then
        term=${GF_EXP[$(( (GF_LOG[yb]+GF_LOG[W[i]]) % 255 ))]}
        acc=$(( acc ^ term ))
      fi
    done
    printf -v hb '%02x' "$acc"; payload_hex+="$hb"
  done

  # Wrapper check (16-byte tag): magic(0x55) | len(2) | secret | tag(16).
  local fail; fail="$(t combine_integrity)"
  (( PL >= 20 )) || { err "$fail"; return 1; }          # 1 magic + 2 len + >=1 secret + 16 tag
  (( 16#${payload_hex:0:2} == 0x55 )) || { err "$fail"; return 1; }
  local len=$(( 16#${payload_hex:2:4} ))
  (( PL == len + 19 )) || { err "$fail"; return 1; }     # 1 + 2 + len + 16
  local core_hex="${payload_hex:0:$(( (len+3)*2 ))}" tag_have="${payload_hex: -32}" tag_want
  tag_want="$(_from_hex "$core_hex" | _sha256_hex)"; tag_want="${tag_want:0:32}"
  [[ "$tag_have" == "$tag_want" ]] || { err "$fail"; return 1; }

  # Integrity confirmed — only now do we honestly report the repaired shares.
  local note
  for note in "${RS_NOTICES[@]:-}"; do [[ -n "$note" ]] && warn "$note"; done

  printf '%s' "${payload_hex:6:$(( len*2 ))}"
}

cmd_combine() {
  local raw; if (( $# )); then raw="$(cat "$@")"; else raw="$(cat)"; fi
  local sh; sh="$(_recover_secret_hex "$raw")" || exit 1
  # Is the reconstructed secret an openssl container (magic "Salted__" = hex 53616c7465645f5f)?
  # Then it is passphrase-encrypted: prompt and decrypt (wrong one → honest refusal).
  # Edge (documented in the README): if a NON-encrypted secret (split without -p) itself begins
  # with exactly the bytes "Salted__" (~2^-64 for arbitrary data, never for textual secrets),
  # combine will mistakenly ask for a passphrase. Not a leak — it just returns "wrong passphrase"
  # instead of the secret; work around by re-splitting with -p or decrypting manually via openssl.
  if [[ "${sh:0:16}" == "53616c7465645f5f" ]]; then
    command -v openssl >/dev/null 2>&1 || { err "$(t pp_locked_noss)"; exit 1; }
    local pp; pp="$(_pp_read_unlock)"
    # fd:3 from a process substitution (a pipe, NOT the on-disk `<<<`) — the passphrase does not spill to disk (P1-5).
    _from_hex "$sh" | openssl enc -d -aes-256-cbc -pbkdf2 -iter "$PP_ITER" -pass fd:3 3< <(printf '%s' "$pp") 2>/dev/null || { pp=""; err "$(t pp_dec_fail)"; exit 1; }
    pp=""
  else
    _from_hex "$sh"
  fi
}

# verify: check that the shares form a valid set and the secret is recoverable — WITHOUT
# printing it (useful when laying shares out across media: confirm correctness without
# revealing the secret).
cmd_verify() {
  local raw; if (( $# )); then raw="$(cat "$@")"; else raw="$(cat)"; fi
  local sh; sh="$(_recover_secret_hex "$raw")" || exit 1
  local n=$(( ${#sh} / 2 ))
  info "$(t verify_ok "$n")"
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then usage; exit 1; fi
  shift || true
  case "$cmd" in
    version|-v|--version) cmd_version "$@" ;;
    help|--help|-h) usage ;;
    split)          cmd_split "$@" ;;
    combine)        cmd_combine "$@" ;;
    verify)         cmd_verify "$@" ;;
    *) t unknown_cmd "$cmd" >&2; echo >&2; usage >&2; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
