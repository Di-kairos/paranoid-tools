# === Shamir Secret Sharing над GF(256) ===
# Поле GF(2^8), редуцирующий многочлен 0x11b (как в AES). Сложение = XOR.
# Умножение — через таблицы log/antilog от генератора 0x03 (примитивный элемент поля).
# Деление/инверсия — через те же таблицы. Все операции — над байтами секрета.
# ПРЕДЕЛ (честно, см. README «Scope & limitations»): умножение через log/antilog-таблицы
# НЕ constant-time — есть тайминговый side-channel. Вне модели угроз локального CLI
# (нет удалённого/онлайн-оракула на split/combine), но мы его не скрываем.

# sha256 → hex (портативно: macOS shasum / Linux sha256sum). Для контрольных сумм.
_sha256_hex() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -d' ' -f1
  else sha256sum | cut -d' ' -f1; fi
}
# bytes(stdin) → hex без пробелов; hex(arg) → raw bytes(stdout). Без xxd (нет на части систем).
_to_hex() { od -An -v -tx1 | tr -d ' \n'; }
_from_hex() { local h="$1" i; for ((i=0; i<${#h}; i+=2)); do printf '%b' "\\x${h:i:2}"; done; }

# Таблицы GF(256): GF_EXP[i]=g^i (g=3), GF_LOG[v]=i. Генерируются один раз.
_gf_init() {
  local x=1 i tt
  GF_EXP=(); GF_LOG=()
  for ((i=0; i<255; i++)); do
    GF_EXP[i]=$x
    GF_LOG[x]=$i
    tt=$(( (x<<1) & 0xff ))                 # xtime(x) = x*2 в GF
    if (( x & 0x80 )); then tt=$(( tt ^ 0x1b )); fi
    x=$(( tt ^ x ))                          # x*3 = xtime(x) XOR x
  done
}

# === Reed-Solomon: коррекция опечаток в переписанной с бумаги доле (формат SSS3) ===
# Зачем: доли живут на бумаге, а бумагу переписывают руками. До SSS3 один неверный символ
# убивал долю целиком — chk4 честно говорил «испорчена», но починить её было нечем.
# RS(k+4, k) над ТЕМ ЖЕ GF(256): 4 байта parity на чанк ≤251 байт полезной нагрузки,
# исправляется до ДВУХ неверных байт в чанке (две опечатки в разных байтах; две опечатки
# в одном байте — тоже одна ошибка). Опечатка в структурной части доли (setid/T/x) НЕ
# корректируется — её ловит chk4; так и написано в README, без вида, что RS чинит всё.
# Декодер — Питерсон для t<=2 + перебор корней: на четырёх синдромах он делает ровно то же,
# что Берлекамп-Мэсси, втрое меньшим кодом. Любая неудача коррекции = честный отказ:
# 128-битный tag полезной нагрузки остаётся последним рубежом против «молча не тот секрет».
RS_PARITY=4          # байт parity на чанк
RS_CHUNK=251         # максимум байт сообщения в чанке (251 + 4 <= 255)

# Умножение в GF(256) без subshell: результат в RES (форк на каждый умножение съел бы всё).
_gf_mul() {
  if (( $1 == 0 || $2 == 0 )); then RES=0
  else RES=${GF_EXP[$(( (GF_LOG[$1]+GF_LOG[$2]) % 255 ))]}; fi
}
# Обратный элемент: inv(a) = g^(255 - log a).
_gf_inv() {
  if (( $1 == 0 )); then RES=0
  else RES=${GF_EXP[$(( (255 - GF_LOG[$1]) % 255 ))]}; fi
}

# Генераторный многочлен g(x) = (x+a^0)(x+a^1)(x+a^2)(x+a^3) в убывающем порядке, RS_G[0]=1.
_rs_gen_init() {
  local i j d
  RS_G=(1)
  for ((i=0; i<RS_PARITY; i++)); do
    local ai=${GF_EXP[i]}
    d=${#RS_G[@]}
    local -a NG=()
    for ((j=0; j<=d; j++)); do NG[j]=0; done
    for ((j=0; j<d; j++)); do
      NG[j]=$(( NG[j] ^ RS_G[j] ))                       # старший сдвиг: умножение на x
      _gf_mul "${RS_G[j]}" "$ai"; NG[j+1]=$(( NG[j+1] ^ RES ))
    done
    RS_G=("${NG[@]}")
  done
}

# Parity для сообщения в RS_MSG[] (байты, старший первым) → RS_PAR[] из RS_PARITY байт.
# Обычное деление многочленов: остаток от msg*x^4 по модулю g. Массивы передаём глобалями,
# а не nameref'ами: `local -n` требует bash 4.3, а на macOS системный bash — 3.2.
_rs_encode() {
  local k=${#RS_MSG[@]} i j
  local -a W=()
  for ((i=0; i<k; i++)); do W[i]=${RS_MSG[i]}; done
  for ((i=0; i<RS_PARITY; i++)); do W[k+i]=0; done
  for ((i=0; i<k; i++)); do
    local coef=${W[i]}
    (( coef == 0 )) && continue
    for ((j=1; j<=RS_PARITY; j++)); do
      _gf_mul "${RS_G[j]}" "$coef"; W[i+j]=$(( W[i+j] ^ RES ))
    done
  done
  RS_PAR=()
  for ((i=0; i<RS_PARITY; i++)); do RS_PAR[i]=${W[k+i]}; done
}

# Синдромы кодового слова RS_CW[] (сообщение + parity): S_i = CW(a^i), i=0..RS_PARITY-1.
# Все нули → ошибок нет.
_rs_syndromes() {
  local n=${#RS_CW[@]} i p
  RS_SYN=()
  for ((i=0; i<RS_PARITY; i++)); do
    local xi=${GF_EXP[i]} acc=0
    for ((p=0; p<n; p++)); do
      _gf_mul "$acc" "$xi"; acc=$(( RES ^ RS_CW[p] ))    # схема Горнера
    done
    RS_SYN[i]=$acc
  done
}

# Исправить до двух байтовых ошибок в кодовом слове (правится на месте).
# RS_FIXED = число исправленных байт. Код возврата: 0 — слово чистое или починено
# и синдромы обнулились; 1 — не поддаётся (fail-closed, молча неверного слова не отдаём).
_rs_correct() {
  local n=${#RS_CW[@]} i p
  _rs_syndromes
  RS_FIXED=0
  local s0=${RS_SYN[0]} s1=${RS_SYN[1]} s2=${RS_SYN[2]} s3=${RS_SYN[3]}
  (( s0 == 0 && s1 == 0 && s2 == 0 && s3 == 0 )) && return 0

  # --- одна ошибка: e = S0, X = S1/S0; проверяем по S2 и S3 ---
  if (( s0 != 0 )); then
    _gf_inv "$s0"; local inv0=$RES
    _gf_mul "$s1" "$inv0"; local X=$RES
    local e=$s0 ok=1 chk
    _gf_mul "$e" "$X"; (( RES == s1 )) || ok=0
    _gf_mul "$X" "$X"; chk=$RES; _gf_mul "$e" "$chk"; (( RES == s2 )) || ok=0
    _gf_mul "$chk" "$X"; chk=$RES; _gf_mul "$e" "$chk"; (( RES == s3 )) || ok=0
    if (( ok )); then
      # X = a^(n-1-p) → позиция p = n-1-log(X)
      (( X != 0 )) || return 1
      p=$(( n - 1 - GF_LOG[X] ))
      (( p >= 0 && p < n )) || return 1
      RS_CW[p]=$(( RS_CW[p] ^ e ))
      RS_FIXED=1
      _rs_syndromes
      (( RS_SYN[0] == 0 && RS_SYN[1] == 0 && RS_SYN[2] == 0 && RS_SYN[3] == 0 )) || return 1
      return 0
    fi
  fi

  # --- две ошибки (Питерсон): l1*S1 + l2*S0 = S2 ; l1*S2 + l2*S1 = S3 ---
  local d a b
  _gf_mul "$s1" "$s1"; d=$RES; _gf_mul "$s0" "$s2"; d=$(( d ^ RES ))
  (( d != 0 )) || return 1
  _gf_inv "$d"; local invd=$RES
  _gf_mul "$s2" "$s1"; a=$RES; _gf_mul "$s0" "$s3"; a=$(( a ^ RES ))
  _gf_mul "$a" "$invd"; local l1=$RES
  _gf_mul "$s1" "$s3"; b=$RES; _gf_mul "$s2" "$s2"; b=$(( b ^ RES ))
  _gf_mul "$b" "$invd"; local l2=$RES

  # Корни L(z) = 1 + l1*z + l2*z^2, где z = X^-1. Перебираем позиции — n <= 255.
  local -a POS=() XV=()
  for ((p=0; p<n; p++)); do
    local Xp=${GF_EXP[$(( (n - 1 - p) % 255 ))]} z v t2
    _gf_inv "$Xp"; z=$RES
    _gf_mul "$l1" "$z"; v=$(( 1 ^ RES ))
    _gf_mul "$z" "$z"; t2=$RES; _gf_mul "$l2" "$t2"; v=$(( v ^ RES ))
    if (( v == 0 )); then POS+=("$p"); XV+=("$Xp"); fi
  done
  (( ${#POS[@]} == 2 )) || return 1

  # Величины: e1 + e2 = S0 ; e1*X1 + e2*X2 = S1.
  local X1=${XV[0]} X2=${XV[1]} den e1 e2
  den=$(( X1 ^ X2 )); (( den != 0 )) || return 1
  _gf_inv "$den"; local invden=$RES
  _gf_mul "$s0" "$X2"; e1=$(( s1 ^ RES )); _gf_mul "$e1" "$invden"; e1=$RES
  e2=$(( s0 ^ e1 ))
  (( e1 != 0 && e2 != 0 )) || return 1
  local p0=${POS[0]} p1=${POS[1]}
  RS_CW[p0]=$(( RS_CW[p0] ^ e1 ))
  RS_CW[p1]=$(( RS_CW[p1] ^ e2 ))
  RS_FIXED=2
  _rs_syndromes
  (( RS_SYN[0] == 0 && RS_SYN[1] == 0 && RS_SYN[2] == 0 && RS_SYN[3] == 0 )) || return 1
  return 0
}

# hex полезной нагрузки → hex parity (чанками по RS_CHUNK байт; для реальных сидов чанк один).
_rs_parity_hex() {
  local hex="$1" total=$(( ${#1} / 2 )) off=0 out="" i hb
  _gf_init; _rs_gen_init
  while (( off < total )); do
    local take=$(( total - off )); (( take > RS_CHUNK )) && take=$RS_CHUNK
    RS_MSG=()
    for ((i=0; i<take; i++)); do RS_MSG[i]=$(( 16#${hex:(off+i)*2:2} )); done
    _rs_encode
    for ((i=0; i<RS_PARITY; i++)); do printf -v hb '%02x' "${RS_PAR[i]}"; out+="$hb"; done
    off=$(( off + take ))
  done
  printf '%s' "$out"
}

# hex нагрузки + hex parity → исправленные RS_OUT_HEX и RS_OUT_PAR_HEX, число правок в
# RS_FIXED_TOTAL. Код возврата 1 — декодер не сошёлся.
# ВАЖНО: parity возвращаем тоже — опечатка могла попасть в него, и тогда исправлять надо его,
# а не тело (иначе chk4 сверялся бы со всё ещё испорченным par и починка не засчитывалась).
_rs_repair_hex() {
  local hex="$1" par="$2" total=$(( ${#1} / 2 )) off=0 ci=0 i hb
  _gf_init; _rs_gen_init
  RS_OUT_HEX=""; RS_OUT_PAR_HEX=""; RS_FIXED_TOTAL=0
  local want_par=$(( ( (total + RS_CHUNK - 1) / RS_CHUNK ) * RS_PARITY ))
  (( ${#par} == want_par * 2 )) || return 1
  while (( off < total )); do
    local take=$(( total - off )); (( take > RS_CHUNK )) && take=$RS_CHUNK
    RS_CW=()
    for ((i=0; i<take; i++)); do RS_CW[i]=$(( 16#${hex:(off+i)*2:2} )); done
    for ((i=0; i<RS_PARITY; i++)); do RS_CW[take+i]=$(( 16#${par:(ci*RS_PARITY+i)*2:2} )); done
    _rs_correct || return 1
    RS_FIXED_TOTAL=$(( RS_FIXED_TOTAL + RS_FIXED ))
    for ((i=0; i<take; i++)); do printf -v hb '%02x' "${RS_CW[i]}"; RS_OUT_HEX+="$hb"; done
    for ((i=0; i<RS_PARITY; i++)); do printf -v hb '%02x' "${RS_CW[take+i]}"; RS_OUT_PAR_HEX+="$hb"; done
    off=$(( off + take )); ci=$(( ci + 1 ))
  done
  return 0
}

# === passphrase-слой (opt-in) ===
# Шифрует секрет ДО разбиения через native openssl (AES-256-CBC + PBKDF2). Так восстановленный
# порог долей даёт лишь стандартный `Salted__`-контейнер — секрет всё ещё под passphrase.
# Ядро split/combine не трогаем (режет/собирает любые байты). openssl нужен ТОЛЬКО для этого
# режима — zero-dep ядра сохранён. Параметры фиксированы → расшифровка совместима везде, где есть openssl.
PP_ITER=200000

# Прочитать passphrase для шифрования (с подтверждением). Env SEEDSPLIT_PASSPHRASE — для тестов/
# автоматизации; иначе скрытый ввод с /dev/tty (stdin занят секретом в pipe). Печатает passphrase в stdout.
_pp_read_set() {
  if [[ -n "${SEEDSPLIT_PASSPHRASE:-}" ]]; then printf '%s' "$SEEDSPLIT_PASSPHRASE"; return 0; fi
  local p1 p2
  printf '%s' "$(t pp_set)" >/dev/tty; read -rs p1 </dev/tty; echo >/dev/tty
  printf '%s' "$(t pp_confirm)" >/dev/tty; read -rs p2 </dev/tty; echo >/dev/tty
  [[ -n "$p1" ]] || { p1=""; p2=""; err "$(t pp_empty)"; return 1; }
  [[ "$p1" == "$p2" ]] || { p1=""; p2=""; err "$(t pp_mismatch)"; return 1; }
  p2=""
  printf '%s' "$p1"
}

# Прочитать passphrase для расшифровки (один ввод). Env-override как у _pp_read_set.
_pp_read_unlock() {
  if [[ -n "${SEEDSPLIT_PASSPHRASE:-}" ]]; then printf '%s' "$SEEDSPLIT_PASSPHRASE"; return 0; fi
  local p
  printf '%s' "$(t pp_locked)" >/dev/tty; read -rs p </dev/tty; echo >/dev/tty
  printf '%s' "$p"
}

# Зашифровать secret_hex passphrase'ом → ct_hex. Passphrase через fd:3 (НЕ argv → не виден в `ps`).
_pp_encrypt_hex() {
  local sec_hex="$1" pp="$2" ct_hex
  # Passphrase через fd:3 из process substitution (pipe, НЕ дисковый here-string `<<<`, который
  # материализовал бы passphrase во временный файл $TMPDIR → карвинг/утечка). См. P1-5.
  ct_hex="$(_from_hex "$sec_hex" | openssl enc -aes-256-cbc -pbkdf2 -iter "$PP_ITER" -salt -pass fd:3 3< <(printf '%s' "$pp") 2>/dev/null | _to_hex)" || return 1
  [[ -n "$ct_hex" ]] || return 1
  printf '%s' "$ct_hex"
}

cmd_split() {
  local n=3 t=2 file="" use_pp=0
  while (( $# )); do
    case "$1" in
      -n|--shares)        n="${2:?}"; shift 2 ;;
      -t|--threshold)     t="${2:?}"; shift 2 ;;
      --file)             file="${2:?}"; shift 2 ;;
      -p|--passphrase)    use_pp=1; shift ;;
      *) err "$(t split_bad_arg "$1")"; exit 1 ;;
    esac
  done

  # Секрет — из stdin или --file, в hex. Никогда из argv (виден в `ps`).
  local secret_hex
  if [[ -n "$file" ]]; then
    [[ -r "$file" ]] || { err "$(t split_file_unreadable "$file")"; exit 1; }
    secret_hex="$(_to_hex < "$file")"
  elif [[ -t 0 ]]; then
    # Интерактивный запуск: без промпта команда просто молчала, ожидая stdin, — это читалось
    # как зависание, а набранный секрет оставался в scrollback. Читаем с /dev/tty без эха,
    # одной строкой (seed-фраза однострочна). Перевод строки в секрет НЕ попадает.
    # IFS= обязателен: с дефолтным IFS bash срезал бы ведущие/хвостовые пробелы, и тот же
    # секрет через TTY и через пайп дал бы РАЗНЫЕ доли. `|| true` — EOF (Ctrl-D) возвращает
    # ненулевой код даже после частичного ввода: под set -e это убило бы и введённые байты,
    # и честную ошибку про пустой секрет ниже.
    local line=""
    printf '%s' "$(t split_prompt)" >/dev/tty
    IFS= read -rs line </dev/tty || true
    echo >/dev/tty
    secret_hex="$(printf '%s' "$line" | _to_hex)"
    line=""
  else
    secret_hex="$(_to_hex)"
  fi
  [[ -n "$secret_hex" ]] || { err "$(t split_empty_secret)"; exit 1; }

  # Passphrase-слой (opt-in): шифруем секрет ДО разбиения. Доли = Shamir поверх шифртекста.
  if (( use_pp )); then
    command -v openssl >/dev/null 2>&1 || { err "$(t pp_no_openssl)"; exit 1; }
    local pp; pp="$(_pp_read_set)" || exit 1
    secret_hex="$(_pp_encrypt_hex "$secret_hex" "$pp")" || { pp=""; err "$(t pp_enc_fail)"; exit 1; }
    pp=""   # вычистить из памяти
  fi

  [[ "$n" =~ ^[0-9]+$ && "$t" =~ ^[0-9]+$ ]] || { err "$(t split_nt_not_num)"; exit 1; }
  (( t >= 2 )) || { err "$(t split_t_min)"; exit 1; }
  (( n >= t )) || { err "$(t split_n_lt_t "$n" "$t")"; exit 1; }
  (( n <= 255 )) || { err "$(t split_n_max)"; exit 1; }

  local L=$(( ${#secret_hex} / 2 ))
  (( L <= 65535 )) || { err "$(t split_secret_big)"; exit 1; }

  # Случайный set-id (4-байтный nonce) — НЕ производный от секрета (иначе confirmation-оракул:
  # имея одну долю + кандидат-секрет, можно было бы проверить догадку, не собирая порог).
  # Одинаков во всех долях набора → combine ДЕТЕРМИНИРОВАННО отвергает смешивание долей
  # из разных сплитов (а не вероятностно).
  local setid_hex
  setid_hex="$(head -c 4 /dev/urandom | _to_hex)"
  [[ ${#setid_hex} -eq 8 ]] || { err "$(t split_low_entropy)"; exit 1; }

  # Обёртка целостности: 0x55 | len(2B BE) | secret | tag(16B = первые 16 байт sha256 предыдущего).
  # 128-битный tag: combine вернёт ЛИБО точный секрет, ЛИБО честный отказ; шанс молча отдать
  # НЕ тот секрет ≈ 2^-128 (против 2^-16 у старого 2-байтного CRC).
  local hi=$(( L >> 8 )) lo=$(( L & 0xff )) core_hex tag_hex
  printf -v core_hex '55%02x%02x%s' "$hi" "$lo" "$secret_hex"
  tag_hex="$(_from_hex "$core_hex" | _sha256_hex)"; tag_hex="${tag_hex:0:32}"
  local payload_hex="${core_hex}${tag_hex}" PL
  PL=$(( ${#payload_hex} / 2 ))

  local -a P=(); local k
  for ((k=0; k<PL; k++)); do P[k]=$(( 16#${payload_hex:k*2:2} )); done

  _gf_init

  # (t-1) случайных байт на каждый байт payload — старшие коэффициенты многочленов.
  local need=$(( (t-1) * PL )) rand_hex
  rand_hex="$(head -c "$need" /dev/urandom | _to_hex)"
  [[ ${#rand_hex} -eq $((need*2)) ]] || { err "$(t split_low_entropy)"; exit 1; }

  local -a Y=(); local x j ri=0 y hb
  for ((x=1; x<=n; x++)); do Y[x]=""; done
  for ((k=0; k<PL; k++)); do
    # Многочлен байта k: c0=P[k] (секрет), c1..c_{t-1} = случайные. Оцениваем в x=1..n (Горнер).
    local -a C=(); C[0]=${P[k]}
    for ((j=1; j<t; j++)); do C[j]=$(( 16#${rand_hex:ri*2:2} )); ri=$((ri+1)); done
    for ((x=1; x<=n; x++)); do
      y=${C[t-1]}
      for ((j=t-2; j>=0; j--)); do
        if (( y != 0 )); then y=${GF_EXP[$(( (GF_LOG[y]+GF_LOG[x]) % 255 ))]}; fi
        y=$(( y ^ C[j] ))
      done
      printf -v hb '%02x' "$y"; Y[x]+="$hb"
    done
  done

  # Доля: SSS3-<setid>-<T>-<x>-<hexY>-<par>-<chk4>.
  #   par  — RS-parity над байтами hexY: чинит до 2 опечаток в самой длинной части доли;
  #   chk4 — быстрая проверка «эта строка вообще целая» (включая setid/T/x, которые RS не кроет);
  #   setid — детерминированный отказ при смешивании долей из разных сплитов.
  # SSS2 (без parity) остаётся читаемым для combine — старые распечатки не превращаются в мусор.
  local -a SHARES=(); local chk body par
  for ((x=1; x<=n; x++)); do
    par="$(_rs_parity_hex "${Y[x]}")"
    body="SSS3-${setid_hex}-${t}-${x}-${Y[x]}-${par}"
    chk="$(printf '%s' "$body" | _sha256_hex)"; chk="${chk:0:4}"
    SHARES+=("${body}-${chk}")
  done

  # Round-trip self-check ДО печати: собрать секрет ровно тем же путём, что `combine`, из первых T
  # долей и сверить с исходным. Ловит любую поломку генерации/GF-математики РАНЬШЕ, чем юзер раздаст
  # доли и сотрёт оригинал сида (иначе потеря без гарантии сборки). Транзиентно материализует T
  # долей (как и обычный combine) — сами доли всё равно идут в stdout, это не утечка секрета.
  local sc_in sc_out
  sc_in="$(printf '%s\n' "${SHARES[@]:0:t}")"
  sc_out="$(_recover_secret_hex "$sc_in" 2>/dev/null)"
  if [[ "$sc_out" != "$secret_hex" ]]; then
    err "$(t split_selfcheck_fail)"; exit 1
  fi

  printf '%s\n' "${SHARES[@]}"
}

# Восстановление секрета из долей: парсинг + ВСЕ проверки + интерполяция Лагранжа в нуле.
# Печатает secret_hex в stdout при успехе; при ЛЮБОЙ ошибке — сообщение в stderr и `return !=0`
# (НЕ exit: функция зовётся в $(...), exit убил бы только subshell и оставил вызывающего без
# проверки статуса). Таксономия ошибок различает: не-SSS2 / порча доли (CRC) / разные сплиты
# (set-id) / расходящийся порог T / ниже порога / провал целостности payload.
_recover_secret_hex() {
  local raw="$1"
  RS_NOTICES=()
  _gf_init
  local -a XS=() YS=()
  local line ylen="" t_decl="" setid_seen="" cnt=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local sid T x yh chk par="" fmt
    if [[ "$line" =~ ^SSS3-([0-9a-f]{8})-([0-9]+)-([0-9]+)-([0-9a-f]+)-([0-9a-f]+)-([0-9a-f]{4})$ ]]; then
      fmt=SSS3
      sid="${BASH_REMATCH[1]}"; T="${BASH_REMATCH[2]}"; x="${BASH_REMATCH[3]}"
      yh="${BASH_REMATCH[4]}"; par="${BASH_REMATCH[5]}"; chk="${BASH_REMATCH[6]}"
    elif [[ "$line" =~ ^SSS2-([0-9a-f]{8})-([0-9]+)-([0-9]+)-([0-9a-f]+)-([0-9a-f]{4})$ ]]; then
      fmt=SSS2
      sid="${BASH_REMATCH[1]}"; T="${BASH_REMATCH[2]}"; x="${BASH_REMATCH[3]}"
      yh="${BASH_REMATCH[4]}"; chk="${BASH_REMATCH[5]}"
    else
      err "$(t combine_not_sss2 "$line")"; return 1
    fi
    local body want
    if [[ "$fmt" == SSS3 ]]; then
      # Длина parity обязана соответствовать числу чанков: иначе доля выглядит целой,
      # но чинить её нечем — а узнать об этом хочется сразу, а не в момент опечатки.
      local chunks=$(( ( (${#yh} / 2) + RS_CHUNK - 1 ) / RS_CHUNK ))
      (( ${#par} == chunks * RS_PARITY * 2 )) || { err "$(t combine_bad_parity "$x")"; return 1; }
      body="SSS3-${sid}-${T}-${x}-${yh}-${par}"
    else body="SSS2-${sid}-${T}-${x}-${yh}"; fi
    want="$(printf '%s' "$body" | _sha256_hex)"; want="${want:0:4}"
    if [[ "$chk" != "$want" ]]; then
      # Сумма не сошлась. У SSS3 есть parity — пробуем починить самую длинную (и самую
      # вероятную для опечатки) часть доли. Чиним ТОЛЬКО если после правки сходится chk4:
      # RS не покрывает setid/T/x, а неверный x дал бы неверную реконструкцию.
      local repaired=0
      if [[ "$fmt" == SSS3 ]] && _rs_repair_hex "$yh" "$par" && (( RS_FIXED_TOTAL > 0 )); then
        local try_body="SSS3-${sid}-${T}-${x}-${RS_OUT_HEX}-${RS_OUT_PAR_HEX}" try_want
        try_want="$(printf '%s' "$try_body" | _sha256_hex)"; try_want="${try_want:0:4}"
        if [[ "$chk" == "$try_want" ]]; then
          yh="$RS_OUT_HEX"; par="$RS_OUT_PAR_HEX"; repaired=1
          # Сообщение копим, а не печатаем сразу: «починил» имеет смысл говорить только после
          # того, как сошёлся 128-битный tag нагрузки. Иначе пользователь читал бы «починено»
          # у набора, который следом честно отвергнут.
          RS_NOTICES+=("$(t combine_repaired "$x" "$RS_FIXED_TOTAL")")
        fi
      fi
      if (( ! repaired )); then
        if [[ "$fmt" == SSS3 ]]; then err "$(t combine_unrepairable "$x")"; else err "$(t combine_corrupt "$x")"; fi
        return 1
      fi
    fi
    (( x >= 1 && x <= 255 )) || { err "$(t combine_bad_x "$x")"; return 1; }
    # set-id: все доли набора обязаны совпадать (детерминированный отказ при смешивании сплитов).
    if [[ -z "$setid_seen" ]]; then setid_seen="$sid"
    elif [[ "$sid" != "$setid_seen" ]]; then
      err "$(t combine_diff_splits "$sid" "$setid_seen")"; return 1
    fi
    # declared-T: все доли обязаны заявлять одинаковый порог.
    if [[ -z "$t_decl" ]]; then t_decl="$T"
    elif [[ "$T" != "$t_decl" ]]; then
      err "$(t combine_diff_t "$T" "$t_decl")"; return 1
    fi
    local d; for d in "${XS[@]:-}"; do [[ "$d" == "$x" ]] && { err "$(t combine_dup "$x")"; return 1; }; done
    [[ -z "$ylen" ]] && ylen="${#yh}"
    [[ "${#yh}" -eq "$ylen" ]] || { err "$(t combine_diff_len)"; return 1; }
    XS+=("$x"); YS+=("$yh"); cnt=$((cnt+1))
  done <<< "$raw"

  (( cnt >= 1 )) || { err "$(t combine_no_shares)"; return 1; }
  if [[ -n "$t_decl" ]] && (( cnt < t_decl )); then
    err "$(t combine_below "$t_decl" "$cnt")"; return 1
  fi

  # Веса Лагранжа в нуле (одинаковы для всех байтов): w_i = prod_{j!=i} x_j * inv(x_i XOR x_j).
  local m=$cnt i j
  local -a W=()
  for ((i=0; i<m; i++)); do
    local num=1 xi="${XS[i]}"
    for ((j=0; j<m; j++)); do
      (( j == i )) && continue
      local xj="${XS[j]}"; local den=$(( xi ^ xj ))
      (( den != 0 )) || { err "$(t combine_coincident)"; return 1; }
      num=${GF_EXP[$(( (GF_LOG[num]+GF_LOG[xj]) % 255 ))]}                 # num *= x_j
      num=${GF_EXP[$(( (GF_LOG[num]+(255-GF_LOG[den])%255) % 255 ))]}      # num *= inv(den)
    done
    W[i]=$num
  done

  # Восстановление каждого байта payload: acc = XOR_i ( y_i[p] * w_i ).
  local PL=$(( ylen / 2 )) p payload_hex="" acc yb term hb
  for ((p=0; p<PL; p++)); do
    acc=0
    for ((i=0; i<m; i++)); do
      yb=$(( 16#${YS[i]:p*2:2} ))
      if (( yb != 0 )); then
        term=${GF_EXP[$(( (GF_LOG[yb]+GF_LOG[W[i]]) % 255 ))]}
        acc=$(( acc ^ term ))
      fi
    done
    printf -v hb '%02x' "$acc"; payload_hex+="$hb"
  done

  # Проверка обёртки (16-байтный tag): magic(0x55) | len(2) | secret | tag(16).
  local fail; fail="$(t combine_integrity)"
  (( PL >= 20 )) || { err "$fail"; return 1; }          # 1 magic + 2 len + >=1 secret + 16 tag
  (( 16#${payload_hex:0:2} == 0x55 )) || { err "$fail"; return 1; }
  local len=$(( 16#${payload_hex:2:4} ))
  (( PL == len + 19 )) || { err "$fail"; return 1; }     # 1 + 2 + len + 16
  local core_hex="${payload_hex:0:$(( (len+3)*2 ))}" tag_have="${payload_hex: -32}" tag_want
  tag_want="$(_from_hex "$core_hex" | _sha256_hex)"; tag_want="${tag_want:0:32}"
  [[ "$tag_have" == "$tag_want" ]] || { err "$fail"; return 1; }

  # Целостность подтверждена — только теперь честно сообщаем о починенных долях.
  local note
  for note in "${RS_NOTICES[@]:-}"; do [[ -n "$note" ]] && warn "$note"; done

  printf '%s' "${payload_hex:6:$(( len*2 ))}"
}

cmd_combine() {
  local raw; if (( $# )); then raw="$(cat "$@")"; else raw="$(cat)"; fi
  local sh; sh="$(_recover_secret_hex "$raw")" || exit 1
  # Восстановленный секрет — openssl-контейнер (magic "Salted__" = hex 53616c7465645f5f)?
  # Значит он зашифрован passphrase'ом: спрашиваем и расшифровываем (неверный → честный отказ).
  # Edge (документирован в README): если НЕ-зашифрованный секрет (split без -p) сам начинается
  # ровно с байтов "Salted__" (для произвольных данных ~2^-64, для текстовых секретов — нет),
  # combine ошибочно попросит passphrase. Это не утечка — просто отдаст «wrong passphrase»
  # вместо секрета; обойти — пере-split с -p или расшифровать вручную через openssl.
  if [[ "${sh:0:16}" == "53616c7465645f5f" ]]; then
    command -v openssl >/dev/null 2>&1 || { err "$(t pp_locked_noss)"; exit 1; }
    local pp; pp="$(_pp_read_unlock)"
    # fd:3 из process substitution (pipe, НЕ дисковый `<<<`) — passphrase не спиллит на диск (P1-5).
    _from_hex "$sh" | openssl enc -d -aes-256-cbc -pbkdf2 -iter "$PP_ITER" -pass fd:3 3< <(printf '%s' "$pp") 2>/dev/null || { pp=""; err "$(t pp_dec_fail)"; exit 1; }
    pp=""
  else
    _from_hex "$sh"
  fi
}

# verify: проверить, что доли образуют валидный набор и секрет восстановим — БЕЗ его печати
# (полезно при раскладке долей по носителям: подтвердить корректность, не раскрывая секрет).
cmd_verify() {
  local raw; if (( $# )); then raw="$(cat "$@")"; else raw="$(cat)"; fi
  local sh; sh="$(_recover_secret_hex "$raw")" || exit 1
  local n=$(( ${#sh} / 2 ))
  info "$(t verify_ok "$n")"
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then usage; exit 1; fi
  shift || true
  case "$cmd" in
    version|-v|--version) cmd_version "$@" ;;
    help|--help|-h) usage ;;
    split)          cmd_split "$@" ;;
    combine)        cmd_combine "$@" ;;
    verify)         cmd_verify "$@" ;;
    *) t unknown_cmd "$cmd" >&2; echo >&2; usage >&2; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
