#!/usr/bin/env bash
# paranoid — interactive launcher for the Paranoid Tools ecosystem (Phase A).
#
# HONESTLY: this is a THIN launcher, not a new tool. It contains no crypto and does NOT touch
# secrets — secrets are typed directly into the stdin of the relevant CLI. paranoid merely shows
# live status and launches the same five signed CLIs, hiding nothing (Scope & limitations and
# `check` verdicts go to the screen as-is). There is no global hotkey/daemon here — that is Phase B.
#
# Zero dependencies (pure Bash). Installed tools are looked up in PATH by name; a missing
# tool is shown greyed out with an install hint, not faked.
set -uo pipefail

PARANOID_VERSION="0.1.0"

# Vault mount point (same one securetrash uses). Overridable (tests/another volume).
VAULT_VOLUME="${ST_VAULT_VOLUME:-/Volumes/SecretVault}"
# Vault container file (securetrash default). Needed to tell "closed" from "not created yet"
# — otherwise the Vault menu item on a clean system would lead to a "no container" dead end.
VAULT_CONTAINER="${ST_VAULT_PATH:-$HOME/SecureVault.sparsebundle}"

# --- locale: en by default; ru — if ST_LANG or the system locale starts with 'ru' ---
_detect_locale() {
  local want="${ST_LANG:-}"
  if [[ -n "$want" ]]; then
    case "$want" in ru*) echo ru ;; *) echo en ;; esac
    return
  fi
  case "${LC_ALL:-${LANG:-}}" in ru*) echo ru ;; *) echo en ;; esac
}
LOCALE="${ST_LOCALE:-$(_detect_locale)}"

# --- color only in a TTY ---
if [[ -t 1 ]]; then
  C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_DIM=$'\033[2m'; C_BLD=$'\033[1m'; C_RST=$'\033[0m'
else
  C_GRN=""; C_YEL=""; C_DIM=""; C_BLD=""; C_RST=""
fi

