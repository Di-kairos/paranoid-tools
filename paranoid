# --- ecosystem tools: the repo for the install hint ---
# After the monorepo migration all tools live in a single repository.
_tool_repo() {
  # Unknown names return empty — parity with the Windows mirror's contract.
  case "$1" in
    securetrash|vaultwatch|panic|seedsplit|ghostdraft)
      echo 'https://github.com/Di-kairos/paranoid-tools' ;;
  esac
}

_tool_installed() { command -v "$1" >/dev/null 2>&1; }

# Run a tool without killing the loop on a nonzero exit code. If the tool is absent — a hint.
_run_tool() {
  local tool="$1"; shift
  if ! _tool_installed "$tool"; then
    echo "${C_YEL}$(t install_hint "$tool" "$(_tool_repo "$tool")")${C_RST}" >&2
    return 0
  fi
  "$tool" "$@" || true
}

# --- status for the dashboard (read-only; degrades to unknown, does not guess) ---
# Is the volume REALLY mounted? A mirror of the canonical `securetrash lib/common.sh:_volume_mounted`
# (the launcher does not vendor common.sh — it uses none of its other primitives). Previously this
# was a `[[ -d "$VAULT_VOLUME" ]]` check: a directory left over from a past mount or created
# by hand read as "OPEN" — and the launcher dashboard scared the user with
# "vault open, data at risk" while ghostdraft and the GUI answered "closed" for the same path.
# The mount point is compared as a whole: a substring search counts `/Volumes/Foo`
# as mounted when `/Volumes/Foo Bar` is mounted.
# Return code: 0 — mounted, 1 — definitely not, 2 — the mount table could not be read.
_volume_mounted() {
  local vol="${1:-}" line mp out
  [[ -n "$vol" ]] || return 1
  command -v mount >/dev/null 2>&1 || return 2
  out="$(mount 2>/dev/null)" || return 2
  [[ -n "$out" ]] || return 2
  while [[ "$vol" == */ && "$vol" != "/" ]]; do vol="${vol%/}"; done
  while IFS= read -r line; do
    [[ "$line" == *" on "* ]] || continue
    mp="${line#* on }"
    mp="${mp% (*}"
    [[ "$mp" == "$vol" ]] && return 0
  done <<<"$out"
  return 1
}

# open / closed / none / unknown. The dashboard "degrades to unknown, does not guess": if
# the mount table could not be read, a green "closed" over an open vault is the worst
# possible lie, so that state is called by its proper name.
_status_vault() {
  local rc
  _volume_mounted "$VAULT_VOLUME" && rc=0 || rc=$?
  case "$rc" in
    0) echo open ;;
    2) echo unknown ;;
    *) if [[ -e "$VAULT_CONTAINER" ]]; then echo closed; else echo none; fi ;;
  esac
}
_status_filevault() {
  command -v fdesetup >/dev/null 2>&1 || { echo unknown; return; }
  # We capture the output into a variable and match a here-string, NOT a direct pipe
  # `fdesetup ... | grep -q`: under `set -o pipefail` such a pipe falsely "fails" —
  # grep -q closes the channel on the first match, the source gets SIGPIPE (code
  # 141), and pipefail makes the whole pipeline nonzero (a false unknown). See also
  # _status_vaultwatch — there the same bug produced "idle" during an active session.
  local s; s="$(fdesetup status 2>/dev/null)"
  if   grep -qi "FileVault is On"  <<<"$s"; then echo on
  elif grep -qi "FileVault is Off" <<<"$s"; then echo off
  else echo unknown; fi
}
_status_vaultwatch() {
  _tool_installed vaultwatch || { echo absent; return; }
  # Active session = the status output contains "session:" in either locale. Capture into a variable +
  # here-string (not `vaultwatch status | grep -q`): a direct pipe under pipefail falsely
  # gave "idle" — grep -q closes the channel after the first line, vaultwatch catches SIGPIPE
  # (141), pipefail makes the pipeline nonzero. Details — in _status_filevault.
  local out; out="$(vaultwatch status 2>/dev/null)"
  if grep -qiE 'session:|сессия:' <<<"$out"; then echo active; else echo idle; fi
}

# --- opt-in update check (OFF by default; network only with explicit consent) ---
# Privacy contract: NO telemetry and no background "phoning home". The check runs ONLY if
# PARANOID_UPDATE_CHECK=1, does nothing but one fetch of the monorepo's public releases.atom
# feed (no API keys, covers all five tools in a single request), is throttled by a 24h
# cache, and on any network error silently skips the tool.

# File mtime in epoch seconds: BSD (macOS) `stat -f %m`, GNU (Linux/CI) `stat -c %Y`.
_file_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }

# The tool's installed version as x.y.z (empty if the tool is absent / the version cannot be parsed).
_tool_version() {
  local tool="$1" out
  _tool_installed "$tool" || return 0
  out="$("$tool" version 2>/dev/null || "$tool" --version 2>/dev/null)" || true
  grep -oE '[0-9]+\.[0-9]+\.[0-9]+' <<<"$out" | head -1
}

# The monorepo release feed, fetched at most once per process. Short timeout:
# the check is synchronous in the render; the 24h summary cache makes this slow
# path rare, but a single render must not hang on a dead network.
_release_feed() {
  if [[ -z "${_FEED_CACHE+x}" ]]; then
    _FEED_CACHE="$(curl -fsSL --connect-timeout 2 --max-time 3 \
      "https://github.com/Di-kairos/paranoid-tools/releases.atom" 2>/dev/null)" || _FEED_CACHE=""
  fi
  printf '%s' "$_FEED_CACHE"
}

# The tool's latest release tag (vX.Y.Z). In tests substituted by a
# PARANOID_UPDATE_FEED file (`tool=vX.Y.Z` lines); otherwise the monorepo's
# releases.atom is scanned for the newest <tool>-vX.Y.Z entry — one feed fetch
# covers all five tools (entries are newest-first).
_fetch_latest_tag() {
  local tool="$1" tag
  if [[ -n "${PARANOID_UPDATE_FEED:-}" ]]; then
    awk -F= -v t="$tool" '$1==t{print $2; exit}' "$PARANOID_UPDATE_FEED" 2>/dev/null
    return 0
  fi
  command -v curl >/dev/null 2>&1 || return 0
  tag="$(_release_feed | grep -oE "${tool}-v[0-9]+\.[0-9]+\.[0-9]+" | head -1)" || true
  [[ -n "$tag" ]] && echo "${tag#"${tool}"-}"
}

# true if $1 (x.y.z) is strictly newer than $2. Numeric per-field sort — without sort -V
# (absent on old BSD). Equal versions → not newer.
_ver_gt() {
  [[ "$1" == "$2" ]] && return 1
  local hi
  hi="$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
  [[ "$hi" == "$1" ]]
}

# A "tool inst→latest, …" summary over installed tools whose release is newer. Empty if
# the check is disabled, everything is fresh, or the network is unavailable. The result is cached for 24h.
_update_summary() {
  [[ "${PARANOID_UPDATE_CHECK:-0}" == "1" ]] || return 0
  local cache_dir cache
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/paranoid-tools"
  cache="$cache_dir/update-check"
  # A fresh cache (<24h) is served as-is; feed mode (tests) does not touch the cache — always recomputes.
  if [[ -z "${PARANOID_UPDATE_FEED:-}" && -f "$cache" ]]; then
    local now mt; now="$(date +%s 2>/dev/null)"; mt="$(_file_mtime "$cache")"
    if [[ -n "$now" && -n "$mt" ]] && (( now - mt < 86400 )); then cat "$cache"; return 0; fi
  fi
  local out="" tool inst latest
  for tool in securetrash vaultwatch panic seedsplit ghostdraft; do
    _tool_installed "$tool" || continue
    inst="$(_tool_version "$tool")"; [[ -n "$inst" ]] || continue
    latest="$(_fetch_latest_tag "$tool")"; latest="${latest#v}"
    # We compare only a clean x.y.z (our tags always are); garbage/x.y is skipped,
    # so that an incomplete version cannot yield a false "newer" (parity with the ps1 validation).
    [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    _ver_gt "$latest" "$inst" && out+="${out:+, }$tool $inst→$latest"
  done
  if [[ -z "${PARANOID_UPDATE_FEED:-}" ]] && mkdir -p "$cache_dir" 2>/dev/null; then
    printf '%s' "$out" >"$cache" 2>/dev/null || true
  fi
  printf '%s' "$out"
}

# A colored dot by state: ok=green, warn=yellow, dim=grey.
_dot() {
  case "$1" in
    ok)   printf '%s●%s' "$C_GRN" "$C_RST" ;;
    warn) printf '%s●%s' "$C_YEL" "$C_RST" ;;
    *)    printf '%s●%s' "$C_DIM" "$C_RST" ;;
  esac
}

# A single menu item: grey + (not installed) if the tool is absent.
_menu_item() {
  local num="$1" label="$2" tool="${3:-}"
  if [[ -n "$tool" ]] && ! _tool_installed "$tool"; then
    printf '  %s%s) %s (%s)%s\n' "$C_DIM" "$num" "$label" "$(t not_installed)" "$C_RST"
  else
    printf '  %s) %s\n' "$num" "$label"
  fi
}

_render() {
  local v fv vw vline
  v="$(_status_vault)"; fv="$(_status_filevault)"; vw="$(_status_vaultwatch)"
  clear 2>/dev/null || true
  printf '\n  %s%s%s' "$C_BLD" "$(t title)" "$C_RST"
  printf '                          macOS\n\n'

  # Vault
  if [[ "$v" == open ]]; then
    printf '  %s      %s %s  (%s)   %s⚠ %s%s\n' \
      "$(t vault)" "$(_dot warn)" "$(t vault_open)" "$VAULT_VOLUME" "$C_YEL" "$(t vault_risk)" "$C_RST"
  elif [[ "$v" == none ]]; then
    printf '  %s      %s %s\n' "$(t vault)" "$(_dot dim)" "$(t vault_none)"
  elif [[ "$v" == unknown ]]; then
    printf '  %s      %s %s\n' "$(t vault)" "$(_dot warn)" "$(t vault_unknown)"
  else
    printf '  %s      %s %s\n' "$(t vault)" "$(_dot ok)" "$(t vault_closed)"
  fi
  # FileVault
  case "$fv" in
    on)  printf '  %s  %s %s\n' "$(t fv)" "$(_dot ok)"   "$(t on)" ;;
    off) printf '  %s  %s %s\n' "$(t fv)" "$(_dot warn)" "$(t off)" ;;
    *)   printf '  %s  %s %s\n' "$(t fv)" "$(_dot dim)"  "$(t unknown)" ;;
  esac
  # vaultwatch
  case "$vw" in
    active) vline="$(vaultwatch status 2>/dev/null | grep -iE 'TTL|auto-exit|авто-выход' | head -1 | sed 's/^ *//')"
            printf '  %s %s %s%s\n' "$(t vw)" "$(_dot ok)" "$(t vw_active)" "${vline:+ — $vline}" ;;
    idle)   printf '  %s %s %s\n' "$(t vw)" "$(_dot dim)" "$(t vw_idle)" ;;
    *)      : ;;  # absent → the vaultwatch line is not shown
  esac
  # Optional updates line (only if PARANOID_UPDATE_CHECK=1 and something newer exists).
  local _upd; _upd="$(_update_summary)"
  if [[ -n "$_upd" ]]; then
    printf '  %s⬆ %s%s %s\n' "$C_YEL" "$(t update_avail)" "$C_RST" "$_upd"
    printf '    %s%s%s\n' "$C_DIM" "$(t update_how)" "$C_RST"
  fi
  echo
  _menu_item 1 "$(t m_status)"
  if _tool_installed panic; then
    printf '  %s2)%s 🔒 %s\n' "$C_BLD" "$C_RST" "$(t m_panic)"
  else
    printf '  %s2) 🔒 %s (%s)%s\n' "$C_DIM" "$(t m_panic)" "$(t not_installed)" "$C_RST"
  fi
  # Submenu groups (3–5). The top level is kept short: reading (1) and the alarm (2) —
  # instantly at the top; everything else is grouped by meaning. The items inside the
  # submenus are greyed out when their tool is absent, so the groups here are always active.
  printf '  3) %s\n' "$(t m_t_vault)"
  printf '  4) %s\n' "$(t m_t_notepad)"
  printf '  5) %s\n' "$(t m_t_secrets)"
  printf '  6) %s\n' "$(t m_update)"
  printf '  0) %s\n\n' "$(t m_quit)"
}

_pause() { read -r -p "  $(t press_enter)… " _ <&0 || true; }

# --- actions ---
# Does the directory look like our clone. Symbolic links to install.sh/paranoid are not
# accepted: `-f` follows the link, so a substituted target would pass the check while
# the user would see the old, trusted path.
_is_clone_dir() {
  local d="${1:-}"
  [[ -n "$d" && -d "$d" ]] || return 1
  [[ -f "$d/install.sh" && ! -L "$d/install.sh" ]] || return 1
  [[ -f "$d/paranoid"   && ! -L "$d/paranoid"   ]] || return 1
  return 0
}

# Where the installer lives. Order: explicit PARANOID_SRC → the path recorded by install.sh at
# the last install → the launcher's own directory (when it is run straight from the clone).
# Empty if nothing matched — then we say so honestly instead of guessing.
_update_source() {
  local state src
  if _is_clone_dir "${PARANOID_SRC:-}"; then
    printf '%s' "$PARANOID_SRC"; return 0
  fi
  state="${XDG_DATA_HOME:-$HOME/.local/share}/paranoid-tools/source"
  if [[ -f "$state" ]]; then
    # We strip ONLY the CR (the file could have ended up with CRLF). A general trim of edge
    # whitespace would change the path itself: with a trailing space that is a different directory.
    src="$(head -n1 "$state" 2>/dev/null || true)"
    src="${src%$'\r'}"
    if [[ "$src" == /* ]] && _is_clone_dir "$src"; then printf '%s' "$src"; return 0; fi
  fi
  src="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)" || src=""
  if _is_clone_dir "$src"; then printf '%s' "$src"; return 0; fi
  return 0
}

# Updating = re-running the installer from the clone: it itself pulls each tool's latest SIGNED
# releases and verifies the signature. There is deliberately no download logic of our own here —
# otherwise a second, unverified path would appear next to the verified one.
_act_update() {
  local src; src="$(_update_source)"
  if [[ -z "$src" ]]; then
    echo "  ${C_YEL}$(t upd_src_none)${C_RST}" >&2
    _pause; return
  fi
  echo "  ${C_DIM}$(t upd_src "$src")${C_RST}"
  local ans
  read -r -p "  $(t upd_confirm) [yes] " ans <&0 || ans=""
  [[ "$ans" == "yes" ]] || { echo "  $(t upd_cancel)"; _pause; return; }

  local pulled=1
  if git -C "$src" rev-parse --git-dir >/dev/null 2>&1; then
    echo "  $(t upd_pull)"
    # --ff-only: silently overwriting the user's local edits is not allowed.
    git -C "$src" pull --ff-only || { pulled=0; echo "  ${C_YEL}$(t upd_pull_fail)${C_RST}" >&2; }
  else
    echo "  ${C_YEL}$(t upd_nogit)${C_RST}" >&2
  fi

  echo "  $(t upd_run)"
  if bash "$src/install.sh"; then
    # The "update available" banner is cached for a day — after the install it would lie.
    rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/paranoid-tools/update-check" 2>/dev/null || true
    # We do not claim "all fresh" if the sources could not be pulled: the installer may
    # have run fine while the clone stayed as it was.
    (( pulled )) || echo "  ${C_YEL}$(t upd_stale_src)${C_RST}" >&2
    echo "  ${C_GRN}$(t upd_done)${C_RST}"
  else
    echo "  ${C_YEL}$(t upd_fail)${C_RST}" >&2
  fi
  _pause
}

_act_status() {
  _run_tool securetrash check
  if _tool_installed vaultwatch; then echo; _run_tool vaultwatch status; fi
  _pause
}
_act_panic() {
  if ! _tool_installed panic; then
    echo "${C_YEL}$(t install_hint panic "$(_tool_repo panic)")${C_RST}" >&2
    _pause; return
  fi
  # Panic mode: INSTANT, no confirmations — speed is the whole point of the button. Always --hard
  # (hide/lock + kill the cloud daemons + clear recents). The accidental-press protection is that
  # the item is explicitly marked "instant" and `panic now` itself requires an explicit verb. Panic is
  # reversible: it is hide & lock, NOT data destruction (for destruction — securetrash destroy).
  _run_tool panic now --hard
  _pause
}
# Ask for the size cap of a new vault. Echoes the chosen size to stdout (empty = the tool's default
# 1g), returns 1 on an invalid format (the caller cancels create/reset). Hints/warnings go to
# stderr so they cannot end up in the substituted argument. sparsebundle is thin → this is a CAP, not a reservation.
_ask_vault_size() {
  local free_g size num
  free_g="$(df -g "$HOME" 2>/dev/null | awk 'NR==2{print $4}')"
  [[ -n "$free_g" ]] && echo "  ${C_DIM}$(t size_free "$free_g")${C_RST}" >&2
  echo "  $(t size_prompt)" >&2
  read -r -p "  > " size <&0 || size=""
  [[ -z "$size" ]] && return 0   # empty → the tool's default (nothing on stdout)
  if ! [[ "$size" =~ ^[0-9]+[gGmM]?$ ]]; then
    echo "  ${C_YEL}$(t size_bad)${C_RST}" >&2; return 1
  fi
  # Cap (in GB) above free space? We warn but allow — it is a cap, not a reservation.
  if [[ -n "$free_g" && "$size" =~ ^([0-9]+)[gG]$ ]]; then
    num="${BASH_REMATCH[1]}"
    (( num > free_g )) && echo "  ${C_YEL}$(t size_cap_warn "$num" "$free_g")${C_RST}" >&2
  fi
  echo "$size"
}
_act_vault() {
  # Three-state: no container → create (otherwise the user hit the dead end
  # "no container, run vault create first" with no visible path to creation); closed → open;
  # open → close. On creation we ask for the size (cap); securetrash asks for the password itself.
  case "$(_status_vault)" in
    open)   _run_tool securetrash vault close ;;
    closed) _run_tool securetrash vault open ;;
    unknown) echo "  ${C_YEL}$(t vault_unknown_act)${C_RST}" ;;
    none)
      echo "  $(t vault_setup_hint)"
      local sz
      # invalid size format → _ask_vault_size returns 1 → we cancel creation (not a dead end).
      if sz="$(_ask_vault_size)"; then
        # shellcheck disable=SC2086  # empty → no argument = the tool's default size
        _run_tool securetrash vault create $sz
      fi
      ;;
  esac
  _pause
}
# Destroying the vault is irreversible. The launcher warns, but the real confirmation (yes)
# and the refusal on a mounted volume with open files are on the securetrash side.
_act_destroy() {
  if ! _tool_installed securetrash; then
    echo "${C_YEL}$(t install_hint securetrash "$(_tool_repo securetrash)")${C_RST}" >&2
    _pause; return
  fi
  local v; v="$(_status_vault)"
  if [[ "$v" == none ]]; then
    echo "  $(t destroy_none)"; _pause; return
  fi
  # An irreversible operation on top of a state we do not know is not our call to make.
  if [[ "$v" == unknown ]]; then
    echo "  ${C_YEL}$(t vault_unknown_act)${C_RST}"; _pause; return
  fi
  echo "  ${C_YEL}$(t destroy_hint)${C_RST}"
  _run_tool securetrash vault destroy
  _pause
}
# Emptying the vault = securetrash vault reset (crypto-shred the container + recreate it empty).
# An honest irreversibility guarantee: in-place overwriting on an SSD is best-effort (the same key
# keeps decrypting residual blocks), while reset throws the key away. The real yes-confirm
# and the new vault's password prompt are on the securetrash side; the launcher only warns.
_act_empty() {
  if ! _tool_installed securetrash; then
    echo "${C_YEL}$(t install_hint securetrash "$(_tool_repo securetrash)")${C_RST}" >&2
    _pause; return
  fi
  local v; v="$(_status_vault)"
  if [[ "$v" == none ]]; then
    echo "  $(t empty_none)"; _pause; return
  fi
  if [[ "$v" == unknown ]]; then
    echo "  ${C_YEL}$(t vault_unknown_act)${C_RST}"; _pause; return
  fi
  echo "  ${C_YEL}$(t empty_hint)${C_RST}"
  local sz
  if sz="$(_ask_vault_size)"; then
    # shellcheck disable=SC2086  # empty → the tool's default size
    _run_tool securetrash vault reset $sz
  fi
  _pause
}
# A hint on exiting the editor (otherwise a novice gets stuck — especially in vim). We show
# BOTH paths (save AND discard) via the keyboard: F-keys in terminals (Warp) are unreliable,
# and a person often wants precisely to exit WITHOUT saving. Esc-then-... works from any mode.
_editor_exit_hint() {
  if [[ "$LOCALE" == ru ]]; then
    case "$1" in
      *vim|*vi)    echo 'нажми Esc, затем ZZ = сохранить и выйти, ZQ = выйти без сохранения (или :wq / :q!)' ;;
      *nano|*pico) echo 'Ctrl-O Enter Ctrl-X = сохранить и выйти; Ctrl-X затем N = выйти без сохранения' ;;
      *emacs)      echo 'Ctrl-X Ctrl-S затем Ctrl-X Ctrl-C = сохранить и выйти' ;;
      *)           echo 'сохранить и выйти' ;;
    esac
  else
    case "$1" in
      *vim|*vi)    echo 'press Esc, then ZZ = save & exit, ZQ = discard & exit (or :wq / :q!)' ;;
      *nano|*pico) echo 'Ctrl-O Enter Ctrl-X = save & exit; Ctrl-X then N = discard' ;;
      *emacs)      echo 'Ctrl-X Ctrl-S then Ctrl-X Ctrl-C = save & exit' ;;
      *)           echo 'save & quit' ;;
    esac
  fi
}
_act_split() {
  # seedsplit prints the prompt itself (it also reads the input without echo) — ours was removed
  # so as not to give two different instructions at once: the old one promised multi-line input with Ctrl-D.
  if _run_tool seedsplit split; then echo; echo "  $(t split_done)"; fi
  _pause
}
_act_combine() {
  echo "  $(t combine_prompt)"
  _run_tool seedsplit combine
  _pause
}
# Runs `ghostdraft new` with an editor hint. $1 — optional flag (e.g. --clipboard).
_ghost_new() {
  local flag="$1" ed
  # We mirror ghostdraft's editor choice (otherwise the hint lies): $EDITOR → vim → nano.
  if [[ -n "${EDITOR:-}" ]]; then ed="$EDITOR"
  elif command -v vim >/dev/null 2>&1; then ed="vim"
  else ed="nano"; fi
  echo "  $(t ghost_editor_hint "$ed" "$(_editor_exit_hint "$ed")")"
  if [[ -n "$flag" ]]; then
    echo "  $(t ghost_clip_hint)"
    _run_tool ghostdraft new "$flag"
  else
    _run_tool ghostdraft new
  fi
}
# The "Notepad" submenu (ghostdraft): two items — an ephemeral note and a clipboard view. The note
# is stored nowhere: write/edit/copy → it vanishes on exit (want to keep it —
# put a file into the open vault yourself). Copying with ~20s auto-clear is built into the "note"
# (ghostdraft new --clipboard offers it on exit itself). Loops until "back" — repeat as needed.
_menu_notepad() {
  while true; do
    clear 2>/dev/null || true
    printf '\n  %s%s%s\n\n' "$C_BLD" "$(t h_notepad)" "$C_RST"
    _menu_item 1 "$(t ghost_note)" ghostdraft
    _menu_item 2 "$(t ghost_pipe)" ghostdraft
    printf '  0) %s\n\n' "$(t back)"
    local c; read -r -p "  $(t choose): " c <&0 || return 0
    case "$c" in
      # A single "note": new --clipboard — you write/edit, on exit it offers a copy to the
      # clipboard with ~20s auto-clear; the draft itself is shredded. Those who do not want to copy — "no".
      1) _ghost_new --clipboard ; _pause ;;
      # pipe reads stdin — without it, it would hang on an empty cursor. We feed it the clipboard.
      2) echo "  $(t ghost_pipe_hint)"; pbpaste 2>/dev/null | _run_tool ghostdraft pipe; _pause ;;
      0|q|Q) return 0 ;;
      *) : ;;
    esac
  done
}
_act_watch() {
  # The guard is already active → item 7 acts as "stop" (a toggle). Otherwise there
  # was no way to turn it off from the menu.
  if [[ "$(_status_vaultwatch)" == active ]]; then
    _run_tool vaultwatch stop "$VAULT_VOLUME"
    _pause; return
  fi
  # Guarding a volume whose mounted state is unknown is a guard session
  # around an empty spot: state will appear on disk, yet there will be nothing to guard.
  if [[ "$(_status_vault)" == unknown ]]; then
    echo "  ${C_YEL}$(t vault_unknown_act)${C_RST}"; _pause; return
  fi
  local ttl; read -r -p "  $(t ask_ttl) " ttl <&0 || ttl=""
  if [[ -n "$ttl" ]]; then
    # We validate the format here: otherwise malformed input yields a vaultwatch error + "idle"
    # on the dashboard, and it is unclear whether it started or not.
    if ! [[ "$ttl" =~ ^[0-9]+[smhd]?$ ]]; then
      echo "  ${C_YEL}$(t ttl_bad)${C_RST}" >&2; _pause; return
    fi
    _run_tool vaultwatch start --ttl "$ttl" "$VAULT_VOLUME"
  else
    _run_tool vaultwatch start "$VAULT_VOLUME"
  fi
  _pause
}

# The "Vault" submenu: all container operations in one place (at Mr.Di's request — otherwise the flat
# menu was a "shovel"). vaultwatch guards PRECISELY the open vault → it also lives here, not as a separate
# block. Item 1 is dynamic by state (none → create; closed → open; open → close),
# reusing the three-state _act_vault. The destructive items (empty/destroy) are greyed out when
# securetrash or the vault is absent; the real confirms are inside securetrash.
_menu_vault() {
  while true; do
    local v vw
    v="$(_status_vault)"; vw="$(_status_vaultwatch)"
    clear 2>/dev/null || true
    printf '\n  %s%s%s\n\n' "$C_BLD" "$(t h_vault)" "$C_RST"
    case "$v" in
      none)    _menu_item 1 "$(t m_v_create)"  securetrash ;;
      closed)  _menu_item 1 "$(t m_v_open)"    securetrash ;;
      open)    _menu_item 1 "$(t m_v_close)"   securetrash ;;
      # State unknown — the item stays visible (otherwise the menu silently loses a line),
      # but it promises not an action but an honest refusal to guess.
      unknown) _menu_item 1 "$(t m_v_unknown)" securetrash ;;
    esac
    # 2 Empty (reset) — greyed out when securetrash / the vault is absent
    if ! _tool_installed securetrash; then
      printf '  %s2) %s (%s)%s\n' "$C_DIM" "$(t m_empty)" "$(t not_installed)" "$C_RST"
    elif [[ "$v" == none ]]; then
      printf '  %s2) %s (%s)%s\n' "$C_DIM" "$(t m_empty)" "$(t empty_na)" "$C_RST"
    elif [[ "$v" == unknown ]]; then
      printf '  %s2) %s (%s)%s\n' "$C_DIM" "$(t m_empty)" "$(t vault_state_na)" "$C_RST"
    else
      printf '  2) %s\n' "$(t m_empty)"
    fi
    # 3 Destroy — greyed out when securetrash / the vault is absent
    if ! _tool_installed securetrash; then
      printf '  %s3) 💣 %s (%s)%s\n' "$C_DIM" "$(t m_destroy)" "$(t not_installed)" "$C_RST"
    elif [[ "$v" == none ]]; then
      printf '  %s3) 💣 %s (%s)%s\n' "$C_DIM" "$(t m_destroy)" "$(t destroy_na)" "$C_RST"
    elif [[ "$v" == unknown ]]; then
      printf '  %s3) 💣 %s (%s)%s\n' "$C_DIM" "$(t m_destroy)" "$(t vault_state_na)" "$C_RST"
    else
      printf '  3) 💣 %s\n' "$(t m_destroy)"
    fi
    # 4 Watch — toggle (active → stop, otherwise → watch)
    if [[ "$vw" == active ]]; then
      _menu_item 4 "$(t m_unwatch)" vaultwatch
    else
      _menu_item 4 "$(t m_watch)"   vaultwatch
    fi
    printf '  0) %s\n\n' "$(t back)"
    local c; read -r -p "  $(t choose): " c <&0 || return 0
    case "$c" in
      1) _act_vault ;;
      2) _act_empty ;;
      3) _act_destroy ;;
      4) _act_watch ;;
      0|q|Q) return 0 ;;
      *) : ;;
    esac
  done
}
# The "Secrets" submenu (seedsplit): split / combine. Loops until "back".
_menu_secrets() {
  while true; do
    clear 2>/dev/null || true
    printf '\n  %s%s%s\n\n' "$C_BLD" "$(t h_secrets)" "$C_RST"
    _menu_item 1 "$(t m_split)"   seedsplit
    _menu_item 2 "$(t m_combine)" seedsplit
    printf '  0) %s\n\n' "$(t back)"
    local c; read -r -p "  $(t choose): " c <&0 || return 0
    case "$c" in
      1) _act_split ;;
      2) _act_combine ;;
      0|q|Q) return 0 ;;
      *) : ;;
    esac
  done
}

usage() {
  cat <<EOF
paranoid $PARANOID_VERSION — interactive launcher for the Paranoid Tools ecosystem.

Usage: paranoid            launch the interactive dashboard
       paranoid version    print the version
       paranoid help       show this help

A thin launcher over the five CLIs (securetrash, vaultwatch, panic, seedsplit,
ghostdraft). It holds no secrets and adds no crypto — it runs the same signed
tools and shows their output (limits and verdicts included) unaltered.
EOF
}

main() {
  case "${1:-}" in
    version|-v|--version) echo "paranoid $PARANOID_VERSION"; return 0 ;;
    help|-h|--help)       usage; return 0 ;;
    "") : ;;
    *) echo "Unknown command: $1" >&2; usage >&2; return 1 ;;
  esac

  # Ctrl-C in a sub-item → back to the menu (not exit). On the dashboard — a clean exit.
  trap 'echo' INT
  local choice
  while true; do
    _render
    read -r -p "  $(t choose): " choice <&0 || { echo; return 0; }
    case "$choice" in
      1) _act_status ;;
      2) _act_panic ;;
      3) _menu_vault ;;
      4) _menu_notepad ;;
      5) _menu_secrets ;;
      6) _act_update ;;
      0|q|Q) echo; return 0 ;;
      *) : ;;   # invalid input → redraw the menu
    esac
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
